<UserControl x:Class="dCompare.Compare.UcCompare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:dCompare.Compare"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:DepthToMarginConverter x:Key="DepthToMarginConverter"/>
        <Style x:Key="SpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.5"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path Selection Area -->
        <StackPanel Grid.Row="0" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Left Path:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Name="LeftPathBox" Margin="5,0" VerticalAlignment="Center" 
                         IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"/>
                <Button Grid.Column="2" Name="BrowseLeftButton" Click="Browse_Click" Margin="2,0" 
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                </Button>

                <Label Grid.Column="4" Content="Right Path:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Name="RightPathBox" Margin="5,0" VerticalAlignment="Center" 
                         IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"/>
                <Button Grid.Column="6" Name="BrowseRightButton" Click="Browse_Click" Margin="2,0" 
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Results Display Area -->
        <ListView Grid.Row="1" Name="ResultListView" Margin="10" SelectionMode="Extended" 
                  MouseDoubleClick="ResultListView_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True" 
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="18"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListView_PreviewMouseRightButtonDown"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy to Left" Click="ContextMenu_CopyToLeft_Click" Tag="{Binding}"/>
                    <MenuItem Header="Move to Left" Click="ContextMenu_CopyToLeft_Click" Tag="{Binding}"/>
                    <MenuItem Header="Copy to Right" Click="ContextMenu_CopyToRight_Click" Tag="{Binding}"/>
                    <MenuItem Header="Move to Right" Click="ContextMenu_CopyToRight_Click" Tag="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Open with..." >
                        <MenuItem Header="Associated" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                    </MenuItem>
                    <MenuItem Header="Open Left Location" Click="ContextMenu_OpenLeftLocation_Click" Tag="{Binding}"/>
                    <MenuItem Header="Open Right Location" Click="ContextMenu_OpenRightLocation_Click" Tag="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Rename" Click="ContextMenu_Properties_Click" Tag="{Binding}" InputGestureText="F2"/>
                    <MenuItem Header="Delete..." Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                    <MenuItem Header="Compare contents" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                    <MenuItem Header="Copy left path to clipboard" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                    <MenuItem Header="Copy right path to clipboard" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Properties" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Left Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSize}" HorizontalAlignment="Right" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Date">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDate}" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusSymbol}" HorizontalAlignment="Center" TextAlignment="Center"
                                           FontWeight="Bold" FontSize="11" Width="40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="=">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="≠">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="&lt;">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value=">">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSize}" HorizontalAlignment="Right" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Date" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDate}" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Progress Overlay -->
        <Grid Grid.Row="1" Background="#80FFFFFF" Visibility="{Binding IsComparing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <ProgressBar Value="{Binding ComparisonProgress}" Minimum="0" Maximum="100" Height="20" Margin="10"/>
                <TextBlock Text="{Binding ComparisonProgress, StringFormat='Comparing: {0:F0}%'}" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="Cancel" Click="CancelCompare_Click" Width="100" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>