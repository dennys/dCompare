<UserControl x:Class="dCompare.UcCompare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:dCompare"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:DepthToMarginConverter x:Key="DepthToMarginConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path Selection Area -->
        <StackPanel Grid.Row="0" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Left Path:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Name="LeftPathBox" Margin="5,0" VerticalAlignment="Center" 
                         IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"/>
                <Button Grid.Column="2" Name="BrowseLeftBtn" Click="BrowseLeft_Click" Margin="2,0" 
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                    <!-- Lighter color -->
                </Button>

                <Label Grid.Column="4" Content="Right Path:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Name="RightPathBox" Margin="5,0" VerticalAlignment="Center" 
                         IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"/>
                <Button Grid.Column="6" Name="BrowseRightBtn" Click="BrowseRight_Click" Margin="2,0" 
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                    <!-- Lighter color -->
                </Button>
            </Grid>

            <!--
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button Name="CompareBtn" Content="Compare" Click="Compare_Click" Padding="20,5" Margin="5"/>
                <Button Name="ExpandAllBtn" Content="Expand All" Click="ExpandAll_Click" Padding="20,5" Margin="5"/>
                <Button Name="CollapseAllBtn" Content="Collapse All" Click="CollapseAll_Click" Padding="20,5" Margin="5"/>
                <Button Name="ShowAllBtn" Content="Show All" Click="ShowAll_Click" Padding="20,5" Margin="5"/>
                <Button Name="ShowDifferentBtn" Content="Different" Click="ShowDifferent_Click" Padding="20,5" Margin="5"/>
                <Button Name="ShowIdenticalBtn" Content="Identical" Click="ShowIdentical_Click" Padding="20,5" Margin="5"/>
                <Button Name="ShowLeftUniqueBtn" Content="Left Unique" Click="ShowLeftUnique_Click" Padding="20,5" Margin="5"/>
                <Button Name="ShowRightUniqueBtn" Content="Right Unique" Click="ShowRightUnique_Click" Padding="20,5" Margin="5"/>
            </StackPanel>
            -->
        </StackPanel>

        <!-- Results Display Area -->
        <ListView Grid.Row="1" Name="ResultListView" Margin="10" SelectionMode="Extended" 
                  MouseDoubleClick="ResultListView_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True" 
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="18"/> <!-- The height of raw -->
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListView_PreviewMouseRightButtonDown"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy to Left" Click="ContextMenu_CopyToLeft_Click" Tag="{Binding}"/>
                    <MenuItem Header="Copy to Right" Click="ContextMenu_CopyToRight_Click" Tag="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Open Left Location" Click="ContextMenu_OpenLeftLocation_Click" Tag="{Binding}"/>
                    <MenuItem Header="Open Right Location" Click="ContextMenu_OpenRightLocation_Click" Tag="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="Properties" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Left Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11"/>
                                <!-- Smaller font for smaller row -->
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSize}" HorizontalAlignment="Right" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Date">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDate}" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusSymbol}" HorizontalAlignment="Center" TextAlignment="Center"
                                           FontWeight="Bold" FontSize="11" Width="40"> <!-- The width is necessary or TextAlignment will not be effective -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="=">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="≠">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="&lt;">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value=">">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSize}" HorizontalAlignment="Right" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Date" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDate}" FontSize="11"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Operation Buttons Area -->
        <!--
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Name="CopyToLeftBtn" Content="Copy to Left" Click="CopyToLeft_Click" Padding="15,5" Margin="5"/>
            <Button Name="CopyToRightBtn" Content="Copy to Right" Click="CopyToRight_Click" Padding="15,5" Margin="5"/>
        </StackPanel>
        -->
    </Grid>
</UserControl>