<UserControl x:Class="dCompare.Compare.CompareControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:dCompare.Compare"
             xmlns:config="clr-namespace:dCompare.Configuration"
             xmlns:infra="clr-namespace:dCompare.Infrastructure"
             mc:Ignorable="d" 
             xmlns:resx="clr-namespace:dCompare.Properties"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <infra:TextToForegroundConverter x:Key="TextToForegroundConverter"/>
        <local:DepthToMarginConverter x:Key="DepthToMarginConverter"/>
        <Style x:Key="SortableColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="ColumnHeader_Click"/>
        </Style>
        <Style x:Key="SpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.5"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Left Side Context Menu -->
        <ContextMenu x:Key="LeftContextMenu">
            <MenuItem Header="{x:Static resx:Resources.CompareContentsMenu}" Click="ContextMenu_CompareContents_Click" Tag="{Binding}"/>
            <MenuItem x:Name="LeftCompareWithMenu" Header="{x:Static resx:Resources.CompareWith}">
                <!-- Dynamically populated in code-behind -->
            </MenuItem>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.CopyToRightMenu}" Click="ContextMenu_CopyToRight_Click" Tag="{Binding}" Icon="{StaticResource CopyToRightIcon}"/>
            <MenuItem Header="{x:Static resx:Resources.MoveToRightMenu}" Click="ContextMenu_MoveToRight_Click" Tag="{Binding}"/>
            <MenuItem Header="{x:Static resx:Resources.DeleteMenu}" Click="ContextMenu_DeleteLeft_Click" Tag="{Binding}" Icon="{StaticResource DeleteIcon}"/>
            <MenuItem Header="{x:Static resx:Resources.RenameMenu}" Click="ContextMenu_Rename_Click" Tag="{Binding}" InputGestureText="F2"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.OpenFileLocationMenu}" Click="ContextMenu_OpenLeftLocation_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.CopyPathnameToClipboardMenu}" Click="ContextMenu_CopyPathnames_Click" Tag="{Binding}"/>
            <MenuItem Header="{x:Static resx:Resources.CopyFilenameToClipboardMenu}" Click="ContextMenu_CopyFilenames_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.PropertiesMenu}" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
        </ContextMenu>
        <!-- Right Side Context Menu -->
        <ContextMenu x:Key="RightContextMenu">
            <MenuItem Header="{x:Static resx:Resources.CompareContentsMenu}" Click="ContextMenu_CompareContents_Click" Tag="{Binding}"/>
            <MenuItem x:Name="RightCompareWithMenu" Header="{x:Static resx:Resources.CompareWith}">
                <!-- Dynamically populated in code-behind -->
            </MenuItem>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.CopyToLeftMenu}" Click="ContextMenu_CopyToLeft_Click" Tag="{Binding}" Icon="{StaticResource CopyToLeftIcon}"/>
            <MenuItem Header="{x:Static resx:Resources.MoveToLeftMenu}" Click="ContextMenu_MoveToLeft_Click" Tag="{Binding}"/>
            <MenuItem Header="{x:Static resx:Resources.DeleteMenu}" Click="ContextMenu_DeleteRight_Click" Tag="{Binding}" Icon="{StaticResource DeleteIcon}"/>
            <MenuItem Header="{x:Static resx:Resources.RenameMenu}" Click="ContextMenu_Rename_Click" Tag="{Binding}" InputGestureText="F2"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.OpenFileLocationMenu}" Click="ContextMenu_OpenRightLocation_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.CopyPathnameToClipboardMenu}" Click="ContextMenu_CopyPathnames_Click" Tag="{Binding}"/>
            <MenuItem Header="{x:Static resx:Resources.CopyFilenameToClipboardMenu}" Click="ContextMenu_CopyFilenames_Click" Tag="{Binding}"/>
            <Separator/>
            <MenuItem Header="{x:Static resx:Resources.PropertiesMenu}" Click="ContextMenu_Properties_Click" Tag="{Binding}"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path Selection Area -->
        <StackPanel Grid.Row="0" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{x:Static resx:Resources.LeftPath}" VerticalAlignment="Center"/>
                <!-- Left Path Input Area -->
                <Grid Grid.Column="1" Name="LeftPathInputArea">
                    <TextBox Name="LeftPathBox"
                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0" VerticalAlignment="Center" IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"
                             PreviewKeyDown="PathBox_PreviewKeyDown" LostFocus="PathBox_LostFocus" />
                    <Popup Name="LeftSuggestionsPopup"
                           IsOpen="{Binding IsSuggestionsOpen}"
                           PlacementTarget="{Binding ElementName=LeftPathBox}"
                           Placement="Bottom"
                           StaysOpen="False">
                        <ListBox Name="LeftSuggestionsListBox"
                                 ItemsSource="{Binding Suggestions}"
                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                 MaxHeight="200" Width="{Binding ActualWidth, ElementName=LeftPathBox}"
                                 PreviewKeyDown="SuggestionsListBox_PreviewKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Popup>
                </Grid>
                <Button Grid.Column="2" Name="BrowseLeftButton" Click="Browse_Click" Margin="2,0" 
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                </Button>

                <ComboBox Grid.Column="3" Name="AlgorithmComboBox" Margin="5,0" VerticalAlignment="Center" Width="200"
                          ItemsSource="{x:Static config:ComparisonAlgorithms.EnabledAlgorithms}"
                          DisplayMemberPath="Key" SelectedValuePath="Value" SelectedValue="{Binding SelectedAlgorithm}"/>

                <Label Grid.Column="4" Content="{x:Static resx:Resources.Filter}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Name="SearchTextBox" Margin="5,0" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, FallbackValue='Search...'}"
                         Foreground="{Binding (Text), ElementName=SearchTextBox, Converter={StaticResource TextToForegroundConverter}}"/>

                <Label Grid.Column="6" Content="{x:Static resx:Resources.RightPath}" VerticalAlignment="Center"/>
                <!-- Right Path Input Area -->
                <Grid Grid.Column="7" Name="RightPathInputArea">
                    <TextBox Name="RightPathBox"
                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0" VerticalAlignment="Center" IsReadOnly="False" IsEnabled="True" TextWrapping="NoWrap"
                             PreviewKeyDown="PathBox_PreviewKeyDown" LostFocus="PathBox_LostFocus" />
                    <Popup Name="RightSuggestionsPopup"
                           IsOpen="{Binding IsSuggestionsOpen}"
                           PlacementTarget="{Binding ElementName=RightPathBox}"
                           Placement="Bottom"
                           StaysOpen="False">
                        <ListBox Name="RightSuggestionsListBox"
                                 ItemsSource="{Binding Suggestions}"
                                 SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                 MaxHeight="200" Width="{Binding ActualWidth, ElementName=RightPathBox}"
                                 PreviewKeyDown="SuggestionsListBox_PreviewKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Popup>
                </Grid>
                <Button Grid.Column="8" Name="BrowseRightButton" Click="Browse_Click" Margin="2,0"
                        Width="24" Height="18" Padding="0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Results Display Area -->
        <ListView Grid.Row="1" Name="ResultListView" Margin="10" SelectionMode="Extended"
                  MouseDoubleClick="ResultListView_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="18"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListView_PreviewMouseRightButtonDown"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource SortableColumnHeaderStyle}">
                    <GridViewColumn Header="Left Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11" ContextMenu="{StaticResource LeftContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSize}" HorizontalAlignment="Right" FontSize="11" 
                                           ContextMenu="{StaticResource LeftContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Left Date">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftDate}" FontSize="11" 
                                           ContextMenu="{StaticResource LeftContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusSymbol}" HorizontalAlignment="Center" TextAlignment="Center"
                                           FontWeight="Bold" FontSize="11" Width="40">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="=">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="≠">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="&lt;">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusSymbol}" Value="&gt;">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Name" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDisplayName}" 
                                           Margin="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}" 
                                           FontSize="11" ContextMenu="{StaticResource RightContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Size" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSize}" HorizontalAlignment="Right" FontSize="11" 
                                           ContextMenu="{StaticResource RightContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Right Date" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightDate}" FontSize="11" 
                                           ContextMenu="{StaticResource RightContextMenu}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Progress Overlay -->
        <Grid Grid.Row="1" Background="#80FFFFFF" Visibility="{Binding IsComparing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <ProgressBar Value="{Binding ComparisonProgress}" Minimum="0" Maximum="100" Height="20" Margin="10"/>
                <TextBlock Text="{Binding ComparisonProgress, StringFormat='Comparing: {0:F0}%'}" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="Cancel" Click="CancelCompare_Click" Width="100" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>