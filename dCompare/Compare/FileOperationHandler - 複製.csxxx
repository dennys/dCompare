    public class FileOperationHandler
    {
        private readonly IFileManager _fileManager;
        private readonly TreeNodeManager _treeNodeManager;
        private FileOperationControl _fileOperationControl;
        private FileOperationWindow _fileOperationWindow;

        // Dictionary to track active jobs and their completion sources.
        private readonly Dictionary<string, TaskCompletionSource<bool>> _activeJobs = new();

        public FileOperationHandler(IFileManager fileManager, TreeNodeManager treeNodeManager)
        {
            _fileManager = fileManager;
            _treeNodeManager = treeNodeManager;
            FindFileOperationControl();
        }
        // Helper method to find FileOperationControl in the visual tree
        private FileOperationControl FindFileOperationControl()
        {
            if (_fileOperationControl != null)
            {
                return _fileOperationControl; // Return cached instance
            }

            var mainWindow = Application.Current.MainWindow;
            if (mainWindow == null)
            {
                Log.Warning("MainWindow is not available.");
                return null;
            }

            // Find FileOperationControl by x:Name or type
            _fileOperationControl = mainWindow.FindName("fileOperationControl") as FileOperationControl;
            if (_fileOperationControl == null)
            {
                // Fallback: Traverse the visual tree to find FileOperationControl
                _fileOperationControl = FindVisualChild<FileOperationControl>(mainWindow);
            }

            if (_fileOperationControl != null)
            {
                // Subscribe to the event if not already subscribed
                //if (!_fileOperationControl.OnTransferStatusChanged.GetInvocationList().Contains(FileOperation_OnTransferStatusChanged))
                //{
                //    _fileOperationControl.OnTransferStatusChanged += FileOperation_OnTransferStatusChanged;
                //}
            }
            else
            {
                Log.Error("Could not find FileOperationControl in the visual tree.");
            }

            return _fileOperationControl;
        }

        // Helper method to traverse the visual tree
        private static T FindVisualChild<T>(DependencyObject parent) where T : DependencyObject
        {
            if (parent == null)
                return null;

            for (int i = 0; i < VisualTreeHelper.GetChildrenCount(parent); i++)
            {
                var child = VisualTreeHelper.GetChild(parent, i);
                if (child is T found)
                {
                    return found;
                }

                var result = FindVisualChild<T>(child);
                if (result != null)
                {
                    return result;
                }
            }
            return null;
        }
        public List<(string Source, string TargetPath, SourceType Type)> GetItemsForTransfer(List<TreeNode> selectedItems, bool toLeft, string targetRoot, string sourceRoot)
        {
            List<(string Source, string TargetPath, SourceType Type)> items = new();
            foreach (var node in selectedItems)
            {
                string sourcePath = toLeft ? node.RightNode?.FullPath : node.LeftNode?.FullPath;
                if (string.IsNullOrEmpty(sourcePath)) continue;

                string relativePath = node.RelativePath ?? string.Empty;
                string destDir = Path.Combine(targetRoot, Path.GetDirectoryName(relativePath) ?? string.Empty);
                string fileName = Path.GetFileName(sourcePath);
                string destPath = Path.Combine(destDir, fileName);

                items.Add((sourcePath, destPath, toLeft ? SourceType.Right : SourceType.Left));
            }
            return items;
        }

        public List<(string Path, SourceType Type)> GetItemsForDeletion(List<TreeNode> selectedItems, bool isLeft)
        {
            List<(string Path, SourceType Type)> paths = new();
            foreach (var node in selectedItems)
            {
                string path = isLeft ? node.LeftNode?.FullPath : node.RightNode?.FullPath;
                if (!string.IsNullOrEmpty(path))
                {
                    paths.Add((path, isLeft ? SourceType.Left : SourceType.Right));
                }
            }
            return paths;
        }

        public async Task DeleteAsync(List<(string Path, SourceType Type)> items)
        {
            if (items.Count == 0)
            {
                return;
            }

            try
            {
                OpenFileOperations();
                if (_fileOperationWindow != null && _fileOperationWindow.IsLoaded)
                {
                    // Get the list of job IDs for the operations we are starting
                    var jobIds = _fileOperationWindow.DeleteMultiple(items);

                    // Create a list of tasks to wait for
                    var tasks = new List<Task>();
                    foreach (var jobId in jobIds)
                    {
                        var tcs = new TaskCompletionSource<bool>();
                        _activeJobs[jobId] = tcs;
                        tasks.Add(tcs.Task);
                    }

                    // Asynchronously wait for all the file operation tasks to complete
                    await Task.WhenAll(tasks);
                }
            }
            catch (Exception ex)
            {
                throw new Exception($"Error deleting items: {ex.Message}");
            }
        }

        public async Task CopyToLeft(List<TreeNode> selectedItems, string leftRoot, string rightRoot)
        {
            var items = GetItemsForTransfer(selectedItems, toLeft: true, leftRoot, rightRoot);
            if (items.Count == 0)
            {
                MessageBox.Show("請選擇至少一個文件或目錄進行同步");
                return;
            }

            try
            {
                OpenFileOperations();
                if (_fileOperationWindow != null && _fileOperationWindow.IsLoaded)
                {
                    // Get the list of job IDs for the operations we are starting.
                    var jobIds = _fileOperationWindow.CopyMultiple(items, true);

                    // Create a list of tasks to wait for.
                    var tasks = new List<Task>();
                    foreach (var jobId in jobIds)
                    {
                        var tcs = new TaskCompletionSource<bool>();
                        _activeJobs[jobId] = tcs;
                        tasks.Add(tcs.Task);
                    }

                    // Asynchronously wait for all the file operation tasks to complete.
                    await Task.WhenAll(tasks);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error copying items: {ex.Message}", Properties.Resources.ErrorTitle, MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        public async Task CopyToRight(List<TreeNode> selectedItems, string leftRoot, string rightRoot)
        {
            var items = GetItemsForTransfer(selectedItems, toLeft: false, rightRoot, leftRoot);
            if (items.Count == 0)
            {
                MessageBox.Show("請選擇至少一個文件或目錄進行同步");
                return;
            }

            try
            {
                //// Create a TaskCompletionSource to await operation completion
                //var tcs = new TaskCompletionSource<bool>();
                //string jobId = Guid.NewGuid().ToString();

                //// Subscribe to FileOperationControl's OnTransferStatusChanged event
                //_fileOperationControl.OnTransferStatusChanged += (id, success, message) =>
                //{
                //    if (id == jobId)
                //    {
                //        if (success)
                //        {
                //            tcs.TrySetResult(true);
                //            Dispatcher.CurrentDispatcher.Invoke(() =>
                //                MessageBox.Show("Copy to right completed successfully.",
                //                                //Properties.Resource.SuccessTitle,
                //                                "Success",
                //                                MessageBoxButton.OK,
                //                                MessageBoxImage.Information));
                //        }
                //        else
                //        {
                //            tcs.TrySetException(new Exception(message));
                //            Dispatcher.CurrentDispatcher.Invoke(() =>
                //                MessageBox.Show($"Error copying items: {message}",
                //                                Properties.Resources.ErrorTitle,
                //                                MessageBoxButton.OK,
                //                                MessageBoxImage.Error));
                //        }
                //    }
                //};

                //// Create a CancellationTokenSource for cancellation
                //var cts = new CancellationTokenSource();

                //// Create a Progress object to update FileOperationControl
                //var progress = new Progress<OperationProgress>(progress =>
                //{
                //    // Update progress in FileOperationControl (handled internally by CopyMultiple)
                //});

                //// Queue the copy operation in FileOperationControl
                //var jobIds = _fileOperationControl.CopyMultiple(items, overwrite: true);
                //if (jobIds.Contains(jobId))
                //{
                //    // Since CopyMultiple generates its own job IDs, we assume the first one for simplicity
                //    jobId = jobIds[0];
                //}

                var jobIds = new List<string>();
                var tasks = new List<Task>();

                foreach (var item in items)
                {
                    string jobId = Guid.NewGuid().ToString();
                    jobIds.Add(jobId);
                    var tcs = new TaskCompletionSource<bool>();
                    _activeJobs[jobId] = tcs;

                    var transfer = new FileTransfer
                    {
                        JobId = jobId,
                        Operation = "Copy",
                        Source = item.Source,
                        Target = item.TargetPath,
                        Status = "Queued",
                        FileSize = Directory.Exists(item.Source) ? 0 : new FileInfo(item.Source).Length,
                        SourceType = item.Type,
                        StartTime = DateTime.Now
                    };

                    Dispatcher.CurrentDispatcher.Invoke(() => _fileOperationControl.QueuedTransfers.Add(transfer));

                    tasks.Add(Task.Run(async () =>
                    {
                        try
                        {
                            var progress = new Progress<OperationProgress>(p =>
                            {
                                Dispatcher.CurrentDispatcher.Invoke(() =>
                                {
                                    transfer.Progress = p.Percentage / 100.0;
                                    transfer.Status = $"Transferring ({p.Percentage:P0})";
                                    if (p.Percentage > 0)
                                    {
                                        transfer.TransferSpeed = (transfer.FileSize * (p.Percentage / 100.0) / 1024.0) / (DateTime.Now - transfer.StartTime).TotalSeconds;
                                    }
                                });
                            });

                            OperationResult result = await _fileManager.CopyAsync(item.Source, item.TargetPath, true, progress: progress);
                            if (result.SuccessCount > 0)
                            {
                                Application.Current.Dispatcher.Invoke(() =>
                                {
                                    //_fileOperationControl.QueuedTransfers.Remove(transfer);
                                    //transfer.Status = "Completed";
                                    //transfer.Progress = 1.0;
                                    //_fileOperationControl.SuccessfulTransfers.Add(transfer);
                                    _fileOperationControl.CompleteTransfer(transfer, true, "Operation completed successfully.");
                                    //_fileOperationControl.OnTransferStatusChanged?.Invoke(jobId, true, "Operation completed successfully.");
                                });
                                tcs.TrySetResult(true);
                            }
                            else
                            {
                                throw new Exception(string.Join("; ", result.FailedItems));
                            }
                            tcs.TrySetResult(true);
                        }
                        catch (Exception ex)
                        {
                            Application.Current.Dispatcher.Invoke(() =>
                            {
                                _fileOperationControl.QueuedTransfers.Remove(transfer);
                                transfer.Status = $"Failed: {ex.Message}";
                                _fileOperationControl.FailedTransfers.Add(transfer);
                                //_fileOperationControl.OnTransferStatusChanged?.Invoke(jobId, false, ex.Message);
                            });
                            tcs.TrySetException(ex);
                        }
                    }));
                }

                await Task.WhenAll(tasks);

                // Start the copy operation via FileManager
                //OperationResult result = await _fileManager.CopyMultipleAsync(items, overwrite: true);
                //if (result.FailCount > 0)
                //{
                //    string failedItems = string.Join("\n", result.FailedItems);
                //    throw new Exception($"Failed to copy {result.FailCount} items:\n{failedItems}");
                //}

                // Wait for the FileOperationControl to signal completion
                //await tcs.Task;
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error copying items: {ex.Message}", Properties.Resources.ErrorTitle, MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        public async Task MoveToLeft(List<TreeNode> selectedItems, string leftRoot, string rightRoot)
        {
            var items = GetItemsForTransfer(selectedItems, toLeft: true, leftRoot, rightRoot);
            if (items.Count == 0)
            {
                MessageBox.Show("請選擇至少一個文件或目錄進行移動");
                return;
            }

            try
            {
                OpenFileOperations();
                if (_fileOperationWindow != null && _fileOperationWindow.IsLoaded)
                {
                    // Get the list of job IDs for the operations we are starting.
                    var jobIds = _fileOperationWindow.MoveMultiple(items, true);

                    // Create a list of tasks to wait for.
                    var tasks = new List<Task>();
                    foreach (var jobId in jobIds)
                    {
                        var tcs = new TaskCompletionSource<bool>();
                        _activeJobs[jobId] = tcs;
                        tasks.Add(tcs.Task);
                    }

                    // Asynchronously wait for all the file operation tasks to complete.
                    await Task.WhenAll(tasks);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error moving items: {ex.Message}", Properties.Resources.ErrorTitle, MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

