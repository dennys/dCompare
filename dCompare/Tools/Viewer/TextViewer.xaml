<UserControl x:Class="dCompare.Tools.Viewer.TextViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:p="clr-namespace:dCompare.Properties">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="{x:Static p:Resources.Open}" Command="{Binding OpenFileCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.Save}" Command="{Binding SaveFileCommand}" Margin="2"/>
            <Button x:Name="toggleReadOnlyButton" Command="{Binding ToggleReadOnlyCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.Search}" Click="Search_Click" Margin="2"/>
            <Button Content="{x:Static p:Resources.Replace}" Click="Replace_Click" Margin="2"/>
            <Button Content="{x:Static p:Resources.Undo}" Command="ApplicationCommands.Undo" Margin="2"/>
            <Button Content="{x:Static p:Resources.Redo}" Command="ApplicationCommands.Redo" Margin="2"/>
            <Button Content="{x:Static p:Resources.ZoomIn}" Command="{Binding ZoomInCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.ZoomOut}" Command="{Binding ZoomOutCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.LineNumbers}" Command="{Binding ToggleLineNumbersCommand}" Margin="2"/>
            <ComboBox x:Name="syntaxHighlightComboBox" Width="100" Margin="2"/>
            <TextBox x:Name="LineInputBox" Width="60" Margin="2"/>
            <Button Content="{x:Static p:Resources.GoToLine}" Command="{Binding GoToLineCommand}" CommandParameter="{Binding Text, ElementName=LineInputBox}" Margin="2"/>
        </ToolBar>
        <StatusBar x:Name="statusBar" DockPanel.Dock="Bottom">
            <Label Content="{Binding WordCount}" ContentStringFormat="{x:Static p:Resources.Words}"/>
            <Label Content="{Binding CharCount}" ContentStringFormat="{x:Static p:Resources.Chars}"/>
        </StatusBar>
        <avalonedit:TextEditor x:Name="textEditor"
                               FontFamily="{Binding FontFamily}"
                               FontSize="{Binding FontSize}"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               IsReadOnly="{Binding IsReadOnly}"
                               WordWrap="{Binding WordWrap}"
                               SyntaxHighlighting="{Binding SelectedSyntaxHighlighting, Mode=TwoWay}"
                               HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                               VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}">
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.SelectAll" />
                    <Separator />
                    <MenuItem Command="ApplicationCommands.Undo" />
                    <MenuItem Command="ApplicationCommands.Redo" />
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>
        </avalonedit:TextEditor>
    </DockPanel>
</UserControl>