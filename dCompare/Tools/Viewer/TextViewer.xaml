<UserControl x:Class="dCompare.Tools.Viewer.TextViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="📂 Open" Click="Open_Click" Margin="2"/>
            <Button Content="💾 Save" Click="Save_Click" Margin="2"/>
            <Button x:Name="toggleReadOnlyButton" Click="ToggleReadOnly_Click" Margin="2" Width="80"/>
            <Button Content="🔍 Search" Click="Search_Click" Margin="2"/>
            <Button Content="🔄 Replace" Click="Replace_Click" Margin="2"/>
            <Button Content="↺ Undo" Click="Undo_Click" Margin="2"/>
            <Button Content="↻ Redo" Click="Redo_Click" Margin="2"/>
            <Button Content="🔎 Zoom In" Click="ZoomIn_Click" Margin="2"/>
            <Button Content="🔍 Zoom Out" Click="ZoomOut_Click" Margin="2"/>
            <Button Content="🔢 Line Numbers" Click="ToggleLineNumbers_Click" Margin="2"/>
            <ComboBox x:Name="syntaxHighlightComboBox" Width="100" Margin="2"/>
            <TextBox x:Name="LineInputBox" Width="60" Margin="2"/>
            <Button Content="🔽 Go to Line" Click="GoToLine_Click" Margin="2"/>
        </ToolBar>
        <StatusBar x:Name="statusBar" DockPanel.Dock="Bottom">
            <Label x:Name="WordCountLabel" Content="Words: 0, Chars: 0"/>
        </StatusBar>
        <avalonedit:TextEditor x:Name="textEditor"
                               FontFamily="Consolas"
                               FontSize="10pt"
                               ShowLineNumbers="True"
                               IsReadOnly="False"
                               ContextMenuOpening="TextEditor_ContextMenuOpening"/>
    </DockPanel>
</UserControl>