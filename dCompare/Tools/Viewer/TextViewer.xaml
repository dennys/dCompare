<UserControl x:Class="dCompare.Tools.Viewer.TextViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="📂 Open" Command="{Binding OpenFileCommand}" Margin="2"/>
            <Button Content="💾 Save" Command="{Binding SaveFileCommand}" Margin="2"/>
            <Button x:Name="toggleReadOnlyButton" Command="{Binding ToggleReadOnlyCommand}" Margin="2"/>
            <Button Content="🔍 Search" Click="Search_Click" Margin="2"/>
            <Button Content="🔄 Replace" Click="Replace_Click" Margin="2"/>
            <Button Content="↺ Undo" Command="ApplicationCommands.Undo" Margin="2"/>
            <Button Content="↻ Redo" Command="ApplicationCommands.Redo" Margin="2"/>
            <Button Content="🔎 Zoom In" Command="{Binding ZoomInCommand}" Margin="2"/>
            <Button Content="🔍 Zoom Out" Command="{Binding ZoomOutCommand}" Margin="2"/>
            <Button Content="🔢 Line Numbers" Command="{Binding ToggleLineNumbersCommand}" Margin="2"/>
            <ComboBox x:Name="syntaxHighlightComboBox" Width="100" Margin="2"/>
            <TextBox x:Name="LineInputBox" Width="60" Margin="2"/>
            <Button Content="🔽 Go to Line" Command="{Binding GoToLineCommand}" CommandParameter="{Binding Text, ElementName=LineInputBox}" Margin="2"/>
        </ToolBar>
        <StatusBar x:Name="statusBar" DockPanel.Dock="Bottom">
            <Label Content="{Binding WordCount}" ContentStringFormat="Words: {0:N0}"/>
            <Label Content="{Binding CharCount}" ContentStringFormat="Chars: {0:N0}"/>
        </StatusBar>
        <avalonedit:TextEditor x:Name="textEditor"
                               FontFamily="{Binding FontFamily}"
                               FontSize="{Binding FontSize}"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               IsReadOnly="{Binding IsReadOnly}"
                               WordWrap="{Binding WordWrap}"
                               SyntaxHighlighting="{Binding SelectedSyntaxHighlighting, Mode=TwoWay}"
                               HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility}"
                               VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}">
            <avalonedit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.SelectAll" />
                    <Separator />
                    <MenuItem Command="ApplicationCommands.Undo" />
                    <MenuItem Command="ApplicationCommands.Redo" />
                </ContextMenu>
            </avalonedit:TextEditor.ContextMenu>
        </avalonedit:TextEditor>
    </DockPanel>
</UserControl>