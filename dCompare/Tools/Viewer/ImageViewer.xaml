<UserControl x:Class="dCompare.Tools.Viewer.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:dCompare.Tools.Viewer"
             xmlns:p="clr-namespace:dCompare.Properties"
             xmlns:infra="clr-namespace:dCompare.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <infra:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <infra:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <infra:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="{x:Static p:Resources.Open}" Command="{Binding OpenImageCommand}" Margin="2"
                    Visibility="{Binding IsDiffView, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.Save}" Command="{Binding SaveImageCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.ZoomIn}" Command="{Binding ZoomInCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.ZoomOut}" Command="{Binding ZoomOutCommand}" Margin="2"/>
            <Button Content="{x:Static p:Resources.ShowExifData}" Command="{Binding ToggleExifVisibilityCommand}" Margin="2"/>
            <Separator Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDimensionSame}" Value="False">
                                <Setter Property="ToolTip" Value="{x:Static p:Resources.ShowDiffDisabledTooltip}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button Command="{Binding ShowDiffCommand}" IsEnabled="{Binding IsDimensionSame}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{x:Static p:Resources.ShowDiff}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiffResultVisible}" Value="True">
                                        <Setter Property="Text" Value="{x:Static p:Resources.HideDiff}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Border>
            <TextBlock Text="{x:Static p:Resources.BlockSize}" Margin="5,0" VerticalAlignment="Center" Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Text="{Binding BlockSize, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalContentAlignment="Center"
                     Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{x:Static p:Resources.Threshold}" Margin="5,0" VerticalAlignment="Center" Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Width="40" VerticalContentAlignment="Center"
                     Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </ToolBar>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,1" Margin="5"
                Visibility="{Binding IsExifVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Headers -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static p:Resources.Left}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static p:Resources.Right}" FontWeight="Bold" HorizontalAlignment="Center"
                           Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Camera -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static p:Resources.Camera}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsExifCameraVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LeftCamera}" HorizontalAlignment="Center" Visibility="{Binding IsExifCameraVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RightCamera}" HorizontalAlignment="Center"
                           Visibility="{Binding IsExifCameraVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCameraDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Lens -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static p:Resources.Lens}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsExifLensVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LeftLens}" HorizontalAlignment="Center" Visibility="{Binding IsExifLensVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RightLens}" HorizontalAlignment="Center"
                           Visibility="{Binding IsExifLensVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLensDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Aperture -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static p:Resources.Aperture}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsExifApertureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LeftAperture}" HorizontalAlignment="Center" Visibility="{Binding IsExifApertureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding RightAperture}" HorizontalAlignment="Center"
                           Visibility="{Binding IsExifApertureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApertureDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Shutter Speed -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static p:Resources.ShutterSpeed}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsExifShutterSpeedVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LeftShutterSpeed}" HorizontalAlignment="Center" Visibility="{Binding IsExifShutterSpeedVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding RightShutterSpeed}" HorizontalAlignment="Center"
                           Visibility="{Binding IsExifShutterSpeedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsShutterSpeedDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ISO -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static p:Resources.ISO}" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IsExifIsoVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LeftIso}" HorizontalAlignment="Center" Visibility="{Binding IsExifIsoVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding RightIso}" HorizontalAlignment="Center"
                           Visibility="{Binding IsExifIsoVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIsoDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5"
                    Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{x:Static p:Resources.LeftImage}" FontWeight="Bold"/>
            <TextBlock Text="{Binding LeftPath}" Margin="5,0"/>
            <TextBlock Text="{x:Static p:Resources.RightImage}" FontWeight="Bold" Margin="20,0,5,0"/>
            <TextBlock Text="{Binding RightPath}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" />
                </Grid.LayoutTransform>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>

                <!-- Layout for Diff View -->
                <Grid Visibility="{Binding IsDiffView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0" Stretch="Uniform" Margin="5">
                        <Canvas Width="{Binding LeftImageSource.PixelWidth}" Height="{Binding LeftImageSource.PixelHeight}">
                            <Image Source="{Binding LeftImageSource}" Stretch="Fill"/>
                            <ItemsControl ItemsSource="{Binding DifferenceRectangles}" Visibility="{Binding IsDiffResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Stroke="Red" StrokeThickness="1" Fill="#33FF0000"
                                                   Width="{Binding Width}" Height="{Binding Height}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>

                    <Viewbox Grid.Column="1" Stretch="Uniform" Margin="5">
                        <Canvas Width="{Binding RightImageSource.PixelWidth}" Height="{Binding RightImageSource.PixelHeight}">
                            <Image Source="{Binding RightImageSource}" Stretch="Fill"/>
                            <ItemsControl ItemsSource="{Binding DifferenceRectangles}" Visibility="{Binding IsDiffResultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Stroke="Red" StrokeThickness="1" Fill="#33FF0000"
                                                   Width="{Binding Width}" Height="{Binding Height}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- Layout for Single View -->
                <Image Source="{Binding LeftImageSource}" Stretch="Uniform" Margin="5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsDiffView, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                       MaxWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                       MaxHeight="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
