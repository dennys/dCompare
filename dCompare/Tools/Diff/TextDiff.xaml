<UserControl x:Class="dCompare.Tools.Diff.TextDiff"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:diff="clr-namespace:dCompare.Tools.Diff"
             xmlns:p="clr-namespace:dCompare.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=diff:TextDiffViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="{x:Static p:Resources.LeftFile}" FontWeight="Bold"/>
            <TextBlock Text="{Binding LeftPath}" Margin="5,0"/>
            <TextBlock Text="{x:Static p:Resources.RightFile}" FontWeight="Bold" Margin="20,0,5,0"/>
            <TextBlock Text="{Binding RightPath}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left File Content -->
            <ListBox x:Name="LeftListBox" Grid.Column="0" ItemsSource="{Binding LeftLines}" Margin="5"
                     Background="#F5F5F5" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                            <Setter Property="Background" Value="#B3E6B3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                            <Setter Property="Background" Value="#FFB3B3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Inlines>
                                <ItemsControl ItemsSource="{Binding SubPieces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Text}">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Background" Value="#A3D6A3"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Background" Value="#F4A3A3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TextBlock.Inlines>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Right File Content -->
            <ListBox x:Name="RightListBox" Grid.Column="1" ItemsSource="{Binding RightLines}" Margin="5"
                     Background="#F5F5F5" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                            <Setter Property="Background" Value="#B3E6B3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                            <Setter Property="Background" Value="#FFB3B3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Inlines>
                                <ItemsControl ItemsSource="{Binding SubPieces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Text}">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Background" Value="#A3D6A3"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="Background" Value="#F4A3A3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </TextBlock.Inlines>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>