<Window x:Class="dCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dCompare"
        xmlns:compare="clr-namespace:dCompare.Compare"
        xmlns:fileop="clr-namespace:dCompare.FileOperation"
        xmlns:resx="clr-namespace:dCompare.Properties"
        Title="dCompare" Height="600" Width="1000"
        Background="#F0F0F0">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding CompareCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveSessionCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadSessionCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Chrome-style Tab Item Template -->
        <Style x:Key="ChromeTabStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="TabGrid" Height="28">
                            <Border x:Name="TabBorder" 
                                    Background="#E8E8E8" 
                                    BorderBrush="#C0C0C0" 
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="8,8,0,0"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tab Title -->
                                    <TextBlock x:Name="TabTitle" 
                                               Grid.Column="0"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header}"
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Left"
                                               Margin="12,0,8,0"
                                               FontSize="12"
                                               Foreground="#333333"
                                               PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Close Button -->
                                    <Button x:Name="CloseButton"
                                            Grid.Column="1"
                                            Width="16" Height="16"
                                            Margin="0,0,8,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseTabCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Cursor="Hand"
                                            ToolTip="Close tab">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBorder" 
                                                        Background="Transparent" 
                                                        CornerRadius="2">
                                                    <Path x:Name="ClosePath"
                                                          Data="M 0 0 L 8 8 M 8 0 L 0 8"
                                                          Stroke="#666666"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBorder" Property="Background" Value="#E81123"/>
                                                        <Setter TargetName="ClosePath" Property="Stroke" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Selected Tab -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C0C0C0"/>
                                <Setter TargetName="TabTitle" Property="Foreground" Value="#000000"/>
                                <Setter TargetName="TabGrid" Property="Panel.ZIndex" Value="100"/>
                            </Trigger>

                            <!-- Hover Effect -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F0F0F0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="AllowDrop" Value="True"/>
            <EventSetter Event="Drop" Handler="TabItem_Drop"/>
        </Style>

        <!-- Chrome-style TabControl Template -->
        <Style x:Key="ChromeTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tab Headers with Add Button -->
                            <Border Grid.Row="0" 
                                    Background="#F8F8F8" 
                                    BorderBrush="#C0C0C0" 
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Height="28">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="8,0,0,0"/>

                                    <!-- Add Tab Button -->
                                    <Button x:Name="AddTabButton"
                                            Width="24" Height="24"
                                            Margin="4,4,8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddTabCommand}"
                                            Cursor="Hand"
                                            ToolTip="Add new tab (Ctrl+N)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AddBorder" 
                                                        Background="Transparent" 
                                                        CornerRadius="2">
                                                    <Path x:Name="AddPath"
                                                          Data="M 0 6 L 12 6 M 6 0 L 6 12"
                                                          Stroke="#666666"
                                                          StrokeThickness="2"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AddBorder" Property="Background" Value="#E0E0E0"/>
                                                        <Setter TargetName="AddPath" Property="Stroke" Value="#333333"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="AddBorder" Property="Background" Value="#D0D0D0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Content Area -->
                            <Border Grid.Row="1" 
                                    Background="White" 
                                    BorderBrush="#C0C0C0" 
                                    BorderThickness="1,0,1,1">
                                <ContentPresenter ContentSource="SelectedContent" Margin="4"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Menu and Toolbar Style -->
        <Style x:Key="UnifiedMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="UnifiedToolBarStyle" TargetType="ToolBar">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#C0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource UnifiedMenuStyle}">
            <MenuItem Header="{x:Static resx:Resources.FileMenu}">
                <MenuItem Header="{x:Static resx:Resources.SaveSessionMenu}" Command="{Binding SaveSessionCommand}" InputGestureText="Ctrl+S" Icon="{StaticResource SaveSessionIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.LoadSessionMenu}" Command="{Binding LoadSessionCommand}" InputGestureText="Ctrl+O" Icon="{StaticResource LoadSessionIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ClearRecentSessionsMenu}" Command="{Binding ClearRecentSessionsCommand}"/>
                <MenuItem x:Name="RecentSessionsMenu" Header="{x:Static resx:Resources.RecentSessionsMenu}">
                    <Separator/>
                    <!-- Recent sessions will be dynamically populated -->
                </MenuItem>
                <Separator/>
                <MenuItem Header="{x:Static resx:Resources.AddTab}" Command="{Binding AddTabCommand}" InputGestureText="Ctrl+N" Icon="{StaticResource AddTabIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.CloseTab}" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W" Icon="{StaticResource CloseTabIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.RenameTab}" Command="{Binding RenameTabCommand}">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static resx:Resources.OptionsMenu}" Command="{Binding OptionsCommand}">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{x:Static resx:Resources.Exit}" Command="{Binding ExitCommand}">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static resx:Resources.ActionMenu}">
                <MenuItem Header="{x:Static resx:Resources.CompareDirectoryMenu}" Command="{Binding CompareCommand}" InputGestureText="Ctrl+R" Icon="{StaticResource CompareIcon}"/>
                <Separator/>
                <MenuItem Header="{x:Static resx:Resources.CopyToLeftMenu}" Command="{Binding CopyToLeftCommand}" Icon="{StaticResource ShowLeftIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.CopyToRightMenu}" Command="{Binding CopyToRightCommand}" Icon="{StaticResource CopyToRightIcon}"/>
            </MenuItem>
            <MenuItem Header="{x:Static resx:Resources.ViewMenu}">
                <MenuItem Header="{x:Static resx:Resources.ExpandAllMenu}" Command="{Binding ExpandAllCommand}" Icon="{StaticResource ExpandAllIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.CollapseAllMenu}" Command="{Binding CollapseAllCommand}" Icon="{StaticResource CollapseAllIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ShowAllMenu}" Command="{Binding ShowAllCommand}" Icon="{StaticResource ShowAllIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ShowDifferentMenu}" Command="{Binding ShowDifferentCommand}" Icon="{StaticResource ShowDifferentIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ShowIdenticalMenu}" Command="{Binding ShowIdenticalCommand}" Icon="{StaticResource ShowIdenticalIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ShowLeftUniqueMenu}" Command="{Binding ShowLeftUniqueCommand}" Icon="{StaticResource ShowLeftIcon}"/>
                <MenuItem Header="{x:Static resx:Resources.ShowRightUniqueMenu}" Command="{Binding ShowRightUniqueCommand}" Icon="{StaticResource ShowRightIcon}"/>
            </MenuItem>
            <MenuItem Header="{x:Static resx:Resources.HelpMenu}">
                <MenuItem Header="{x:Static resx:Resources.About}" Command="{Binding AboutCommand}">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ToolBar -->
        <ToolBar DockPanel.Dock="Top" Style="{StaticResource UnifiedToolBarStyle}">
            <!-- New Tab Button -->
            <Button Command="{Binding AddTabCommand}" ToolTip="{x:Static resx:Resources.AddTabTooltip}" Content="{StaticResource AddTabIcon}" />

            <!-- Close Tab Button -->
            <Button Command="{Binding CloseTabCommand}" ToolTip="{x:Static resx:Resources.CloseTabTooltip}" Content="{StaticResource CloseTabIcon}" />

            <!-- Options Button -->
            <Button Command="{Binding OptionsCommand}" ToolTip="{x:Static resx:Resources.OptionsMenu}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16"/>
            </Button>

            <Separator/>

            <!-- Save Session Button -->
            <Button Command="{Binding SaveSessionCommand}" ToolTip="{x:Static resx:Resources.SaveSessionMenu}" Content="{StaticResource SaveSessionIcon}" />

            <!-- Load Session Button -->
            <Button Command="{Binding LoadSessionCommand}" ToolTip="{x:Static resx:Resources.LoadSessionMenu}" Content="{StaticResource LoadSessionIcon}" />

            <Separator/>

            <!-- Compare Button -->
            <Button Command="{Binding CompareCommand}" ToolTip="{x:Static resx:Resources.CompareDirectoryMenu}" Content="{StaticResource CompareIcon}" />

            <!-- Copy to Left Button -->
            <Button Command="{Binding CopyToLeftCommand}" ToolTip="{x:Static resx:Resources.CopyToLeftMenu}" Content="{StaticResource CopyToLeftIcon}" />

            <!-- Copy to Right Button -->
            <Button Command="{Binding CopyToRightCommand}" ToolTip="{x:Static resx:Resources.CopyToRightMenu}" Content="{StaticResource CopyToRightIcon}" />

            <Separator/>

            <!-- Expand All Button -->
            <Button Command="{Binding ExpandAllCommand}" ToolTip="{x:Static resx:Resources.ExpandAllMenu}" Content="{StaticResource ExpandAllIcon}" />

            <!-- Collapse All Button -->
            <Button Command="{Binding CollapseAllCommand}" ToolTip="{x:Static resx:Resources.CollapseAllMenu}" Content="{StaticResource CollapseAllIcon}" />

            <!-- Show All Button -->
            <Button Command="{Binding ShowAllCommand}" ToolTip="{x:Static resx:Resources.ShowAllMenu}" Content="{StaticResource ShowAllIcon}" />

            <!-- Show Different Button -->
            <Button Command="{Binding ShowDifferentCommand}" ToolTip="{x:Static resx:Resources.ShowDifferentMenu}" Content="{StaticResource ShowDifferentIcon}" />

            <!-- Show Identical Button -->
            <Button Command="{Binding ShowIdenticalCommand}" ToolTip="{x:Static resx:Resources.ShowIdenticalMenu}" Content="{StaticResource ShowIdenticalIcon}" />

            <!-- Show Left Unique Button -->
            <Button Command="{Binding ShowLeftUniqueCommand}" ToolTip="{x:Static resx:Resources.ShowLeftUniqueMenu}" Content="{StaticResource ShowLeftIcon}" />

            <!-- Show Right Unique Button -->
            <Button Command="{Binding ShowRightUniqueCommand}" ToolTip="{x:Static resx:Resources.ShowRightUniqueMenu}" Content="{StaticResource ShowRightIcon}" />
            <Separator/>

            <!-- About Button -->
            <Button Command="{Binding AboutCommand}" ToolTip="{x:Static resx:Resources.AboutTooltip}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16"/>
            </Button>
        </ToolBar>

        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100"/>
                <RowDefinition Height="Auto" MinHeight="0" MaxHeight="300"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main TabControl -->
            <TabControl x:Name="tabControl" 
                        Grid.Row="0"
                        Style="{StaticResource ChromeTabControlStyle}"
                        ItemContainerStyle="{StaticResource ChromeTabStyle}"
                        PreviewMouseMove="TabControl_PreviewMouseMove">
                <TabItem Header="Welcome">
                    <!-- <compare:U 인증서ontrol/> -->
                </TabItem>
            </TabControl>

            <!-- File Operation Control -->
            <Expander x:Name="FileOperationExpander" 
                      Grid.Row="1" 
                      Header="File Operations" 
                      IsExpanded="False" FontSize="10">
                <fileop:FileOperationControl x:Name="fileOperationControl"/>
            </Expander>

            <!-- Status Bar -->
            <StatusBar Grid.Row="2" 
                       Background="#F8F8F8" 
                       BorderBrush="#C0C0C0" 
                       BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#333333"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="TabCountText" Text="{Binding ElementName=tabControl, Path=Items.Count, StringFormat='Tabs: {0}'}" Foreground="#666666"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>