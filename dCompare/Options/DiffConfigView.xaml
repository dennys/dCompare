<UserControl x:Class="dCompare.Options.DiffConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource ControlBackground}">
    <UserControl.Resources>
        <!-- Common Extensions for Suggestions -->
        <x:Array x:Key="CommonExtensions" Type="sys:String">
            <sys:String>.cs</sys:String>
            <sys:String>.json</sys:String>
            <sys:String>.log</sys:String>
            <sys:String>.md</sys:String>
            <sys:String>.txt</sys:String>
            <sys:String>.xaml</sys:String>
            <sys:String>.xml</sys:String>
            <sys:String>.html</sys:String>
            <sys:String>.css</sys:String>
            <sys:String>.js</sys:String>
            <sys:String>.png</sys:String>
            <sys:String>.jpg</sys:String>
            <sys:String>.jpeg</sys:String>
            <sys:String>.bmp</sys:String>
            <sys:String>.gif</sys:String>
        </x:Array>
        <!-- Style for Buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <!-- Style for ListBox -->
        <Style x:Key="ExtensionListStyle" TargetType="ListBox">
            <Setter Property="MinHeight" Value="100"/>
            <Setter Property="MaxHeight" Value="150"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <GroupBox Header="Text Diff Settings" Margin="0,0,0,10" Foreground="{DynamicResource TextColor}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Text Viewer -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Text Viewer" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" ToolTip="Select the viewer for text file differences"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding Text.Viewer}" SelectedValuePath="Content" ToolTip="Choose a text diff viewer">
                        <ComboBoxItem>DiffPlex</ComboBoxItem>
                        <ComboBoxItem>DiffPlexQ</ComboBoxItem>
                        <ComboBoxItem>CustomTextViewer</ComboBoxItem>
                    </ComboBox>
                    <!-- Text Extensions -->
                    <Label Grid.Row="1" Grid.Column="0" Content="File Extensions" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" ToolTip="Supported file extensions for text diff"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                        <ListBox x:Name="TextExtList" ItemsSource="{Binding Text.Ext}" SelectedItem="{Binding SelectedTextExt, Mode=TwoWay}" Style="{StaticResource ExtensionListStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="TextExtCombo" Width="150" Margin="0,0,5,0" ItemsSource="{StaticResource CommonExtensions}"
                                      IsEditable="True" ToolTip="Type or select a file extension (e.g., .txt)"/>
                            <Button Content="Add" Style="{StaticResource ActionButtonStyle}" Click="AddTextExtension_Click"/>
                            <Button Content="Remove" Style="{StaticResource ActionButtonStyle}" Click="RemoveTextExtension_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox Header="Image Diff Settings" Margin="0,0,0,10" Foreground="{DynamicResource TextColor}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Image Viewer -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Image Viewer" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" ToolTip="Select the viewer for image file differences"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="5" Width="200" HorizontalAlignment="Left"
                              SelectedValue="{Binding Image.Viewer}" SelectedValuePath="Content" ToolTip="Choose an image diff viewer">
                        <ComboBoxItem>Not implemented</ComboBoxItem>
                        <ComboBoxItem>ImageDiff</ComboBoxItem>
                        <ComboBoxItem>CustomImageViewer</ComboBoxItem>
                    </ComboBox>
                    <!-- Image Extensions -->
                    <Label Grid.Row="1" Grid.Column="0" Content="File Extensions" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" ToolTip="Supported file extensions for image diff"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                        <ListBox x:Name="ImageExtList" ItemsSource="{Binding Image.Ext}" SelectedItem="{Binding SelectedImageExt, Mode=TwoWay}" Style="{StaticResource ExtensionListStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="ImageExtCombo" Width="150" Margin="0,0,5,0" ItemsSource="{StaticResource CommonExtensions}"
                                      IsEditable="True" ToolTip="Type or select a file extension (e.g., .png)"/>
                            <Button Content="Add" Style="{StaticResource ActionButtonStyle}" Click="AddImageExtension_Click"/>
                            <Button Content="Remove" Style="{StaticResource ActionButtonStyle}" Click="RemoveImageExtension_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>