<UserControl x:Class="dCompare.Options.UIGeneralConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{DynamicResource ControlBackground}">
    <StackPanel Margin="10">
        <Label Content="Theme" Foreground="{DynamicResource TextColor}"/>
        <ComboBox SelectedItem="{Binding Theme, UpdateSourceTrigger=PropertyChanged}" Margin="5">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Light</sys:String>
                    <sys:String>Dark</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>
        <Label Content="Language" Margin="0,10,0,0" Foreground="{DynamicResource TextColor}"/>
        <ComboBox SelectedItem="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Margin="5">
            <ComboBox.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>en-US</sys:String>
                    <sys:String>zh-TW</sys:String>
                    <sys:String>zh-CN</sys:String>
                </x:Array>
            </ComboBox.ItemsSource>
        </ComboBox>
    </StackPanel>
</UserControl>