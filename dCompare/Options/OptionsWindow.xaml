<Window x:Class="dCompare.Options.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dCompare.Options"
        xmlns:controls="clr-namespace:dCompare.Controls"
        xmlns:infra="clr-namespace:dCompare.Infrastructure"
        mc:Ignorable="d"
        xmlns:resx="clr-namespace:dCompare.Properties"
        Title="Settings" Height="680" Width="800"
        d:DataContext="{d:DesignInstance Type=local:SettingsViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <infra:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />

        <Style x:Key="HotKeyBoxStyle" TargetType="{x:Type controls:HotKeyTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:HotKeyTextBox}">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="watermark" Text="Click to set a hotkey" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF007ACC"/>
                                <Setter Property="Background" Value="#F0F8FF" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" TargetName="watermark" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="This hotkey is already in use."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Content" Value="&#x2716;"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type local:UIOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.UISettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.Theme}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                      ItemsSource="{Binding AvailableThemes}" 
                      SelectedItem="{Binding Theme}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.Language}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                      ItemsSource="{Binding AvailableLanguages}" 
                      DisplayMemberPath="Key"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Language}"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static resx:Resources.RestartRequiredHint}"
                       Foreground="DarkOrange" FontStyle="Italic" Margin="0,10,0,0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CompareOptionsViewModel}">
            <StackPanel Margin="20" Background="#FFF" >
                <TextBlock Text="Compare Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <GroupBox Header="Scan Options" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scan Method:" VerticalAlignment="Center" Margin="0,5"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding AvailableScanMethods}"
                              SelectedItem="{Binding ScanMethod}"/>

                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Choose 'General' for standard file system scanning or 'MFT' for faster scanning using the Master File Table (Windows NTFS only)."
                               FontStyle="Italic" Foreground="Gray" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding Parallel}" Content="Enable Parallel Scanning" Margin="0,10,0,0"/>
                        <TextBlock Text="Enable to perform file comparisons in parallel for faster processing (recommended for multi-core systems)."
                           FontStyle="Italic" Foreground="Gray" Margin="20,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Comparison Algorithms" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Enable" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Default" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Algorithm" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="Percent %" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>
                        <Separator/>

                        <ItemsControl ItemsSource="{Binding AlgorithmItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <RadioButton Grid.Column="1" IsChecked="{Binding IsDefault}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Width="60" 
                                         IsEnabled="{Binding IsPercentageSettingEnabled}"
                                         Text="{Binding ComparisonPercentage, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                         HorizontalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="User Interaction">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Double Click Action:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableDoubleClickActions}"
                          SelectedItem="{Binding DoubleClickAction}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ListEditButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>


        <DataTemplate DataType="{x:Type local:DiffOptionsViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="Diff Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                <TabControl>
                    <TabItem Header="Text Diff">
                        <StackPanel Margin="15">
                            <TextBlock Text="Viewer:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                            <ComboBox Margin="0,0,0,15"
                                      ItemsSource="{Binding AvailableTextViewers}"
                                      SelectedItem="{Binding SelectedTextViewer}"/>
                            <TextBlock Text="File Extensions:" Margin="0,5,10,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding TextExtensionEditor.Extensions}" 
                                         SelectedItem="{Binding TextExtensionEditor.SelectedExtension}" 
                                         Height="250" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="+" Command="{Binding TextExtensionEditor.AddExtensionCommand}" Style="{StaticResource ListEditButtonStyle}"/>
                                    <Button Content="-" Command="{Binding TextExtensionEditor.RemoveExtensionCommand}" Style="{StaticResource ListEditButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Image Diff">
                        <StackPanel Margin="15">
                            <TextBlock Text="Viewer:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                            <ComboBox Margin="0,0,0,15"
                                      ItemsSource="{Binding AvailableImageViewers}"
                                      SelectedItem="{Binding SelectedImageViewer}"/>
                            <TextBlock Text="File Extensions:" Margin="0,5,10,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding ImageExtensionEditor.Extensions}" 
                                         SelectedItem="{Binding ImageExtensionEditor.SelectedExtension}" 
                                         Height="250" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="+" Command="{Binding ImageExtensionEditor.AddExtensionCommand}" Style="{StaticResource ListEditButtonStyle}"/>
                                    <Button Content="-" Command="{Binding ImageExtensionEditor.RemoveExtensionCommand}" Style="{StaticResource ListEditButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="External Viewers">
                        <DockPanel Margin="15">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Add New" Command="{Binding AddViewerCommand}" Width="80" />
                                <Button Content="Remove" Command="{Binding RemoveViewerCommand}" CommandParameter="{Binding SelectedExternalViewer}" Width="80" Margin="5,0,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding ExternalViewers}"
                                      SelectedItem="{Binding SelectedExternalViewer}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    <DataGridTemplateColumn Header="Executable Path" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="..." 
                                                            Command="{Binding DataContext.BrowsePathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            Margin="5,0,0,0" Padding="5,1"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ConfirmationOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="Confirmation Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <GroupBox Header="General Confirmations" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding CloseApplication}" Content="Confirm before closing application" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding CloseTab}" Content="Confirm before closing a tab" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding Copy}" Content="Confirm before copying files" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding Move}" Content="Confirm before moving files" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Dangerous Actions">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding CopyOverwrite}" Content="Confirm before overwriting files during copy" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding MoveOverwrite}" Content="Confirm before overwriting files during move" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding DeleteFile}" Content="Confirm before deleting files" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:SessionOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="Session Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Default Session File:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBox Text="{Binding DefaultSessionFile, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,5"/>
                    <Button Grid.Column="1" Content="..." VerticalAlignment="Center" Padding="10,2" Margin="5,0" Command="{Binding BrowseSessionFileCommand}"/>
                </Grid>
                <CheckBox IsChecked="{Binding AutoLoadDefaultSession}" Content="Auto-load default session on startup" Margin="0,10"/>
                <CheckBox IsChecked="{Binding AutoCompareAfterSessionLoad}" 
                          IsEnabled="{Binding AutoLoadDefaultSession}" 
                          Content="Auto-compare after session load" Margin="0,5"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HotKeysOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="Hotkey Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>

                <TextBlock Text="Click a box and press a key combination to set the hotkey. Use Backspace or the '✖' button to clear." 
                           Foreground="SlateGray" 
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding HotKeyItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" 
                                  ToolTip="Press your desired key combination (e.g., Ctrl+S).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>

                                <controls:HotKeyTextBox Grid.Column="1" 
                                                      Text="{Binding Combination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HotKeyBoxStyle}"/>

                                <Button Grid.Column="2" 
                                        Style="{StaticResource ClearButtonStyle}"
                                        Command="{Binding ClearCommand}"
                                        Margin="5,0,0,0"
                                        Visibility="{Binding Combination, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:LogOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="Log Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <CheckBox IsChecked="{Binding IsEnabled}" Content="Enable logging" Margin="0,10"/>
                <Grid IsEnabled="{Binding IsEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Log Level:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding AvailableLogLevels}" 
                              SelectedItem="{Binding Level}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Retention (days):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                             Text="{Binding RetentionDays}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TextViewerOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="Text Viewer Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <CheckBox IsChecked="{Binding ReadOnly}" Content="Default to Read Only" Margin="0,5"/>
                <CheckBox IsChecked="{Binding LineNumber}" Content="Show Line Numbers" Margin="0,5"/>
                <CheckBox IsChecked="{Binding SyntaxHighlight}" Content="Enable Syntax Highlighting" Margin="0,5"/>
                <CheckBox IsChecked="{Binding WordWrap}" Content="Enable Word Wrap" Margin="0,5"/>
                <CheckBox IsChecked="{Binding ShowStatusBar}" Content="Show Status Bar" Margin="0,5"/>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding FontDisplay}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Select Font..." Command="{Binding SelectFontCommand}" Margin="5,0"/>
                </Grid>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Horizontal Scroll Bar:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding ScrollBarVisibilities}"
                              SelectedItem="{Binding HorizontalScrollBarVisibility}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Vertical Scroll Bar:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding ScrollBarVisibilities}"
                              SelectedItem="{Binding VerticalScrollBarVisibility}"/>
                </Grid>

                <Button Content="Reset to Default" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ToolsOptionsViewModel}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                    <Button Content="Add" Command="{Binding AddToolCommand}" Width="80" Margin="5"/>
                    <Button Content="Remove" Command="{Binding RemoveToolCommand}" Width="80" Margin="5"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid DataContext="{Binding SelectedTool}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5">
                        <TextBox.Text>
                            <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Handler:" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Handler, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Path:" Margin="5"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExternal}" Margin="5,5,0,5"/>
                        <Button Grid.Column="1" Content="..." Command="{Binding BrowseCommand}" IsEnabled="{Binding IsExternal}" Margin="5,5,5,5" Padding="5,1"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Diff Arguments:" Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DiffArguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExternal}" Margin="5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="View Arguments:" Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ViewArguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExternal}" Margin="5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Supported Operations:" Margin="5"/>
                    <ListBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding AvailableOperations}" SelectedValue="{Binding SupportedOperations}" SelectionMode="Multiple" Margin="5"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Supported Extensions:" Margin="5"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="5">
                        <TextBox.Text>
                            <Binding Path="SupportedExtensions" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Features:" Margin="5"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Features, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Enabled}" Content="Enabled" Margin="5"/>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FileTypeMappingOptionsViewModel}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                    <Button Content="Add" Command="{Binding AddMappingCommand}" Width="80" Margin="5"/>
                    <Button Content="Remove" Command="{Binding RemoveMappingCommand}" Width="80" Margin="5"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid DataContext="{Binding SelectedMapping}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Extensions:" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Default Diff Tool:" Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedItem="{Binding DefaultDiffTool}" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Default View Tool:" Margin="5"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedItem="{Binding DefaultViewTool}" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Preferred Diff Tools:" Margin="5"/>
                    <ListBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedValue="{Binding PreferredDiffTools}" SelectionMode="Multiple" Margin="5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Preferred View Tools:" Margin="5"/>
                    <ListBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedValue="{Binding PreferredViewTools}" SelectionMode="Multiple" Margin="5"/>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="5">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="5" Name="FilterTextBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filter settings..." GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                <TreeView ItemsSource="{Binding MenuItems}" x:Name="SettingsTree">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:SettingsMenuItem}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#FDFDFD">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" 
                  Margin="5">
                <ContentControl Content="{Binding SelectedViewModel}"
                        d:Content="{d:DesignInstance local:UIOptionsViewModel}"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="Save" Width="80" Margin="5" Command="{Binding SaveCommand}"/>
                <Button Content="Cancel" Width="80" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>