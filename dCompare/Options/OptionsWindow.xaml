<Window x:Class="dCompare.Options.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dCompare.Options"
        xmlns:controls="clr-namespace:dCompare.Controls"
        xmlns:infra="clr-namespace:dCompare.Infrastructure"
        xmlns:helper="clr-namespace:dCompare.Options"
        mc:Ignorable="d"
        xmlns:resx="clr-namespace:dCompare.Properties"
        Title="{x:Static resx:Resources.Settings}" Height="680" Width="800"
        d:DataContext="{d:DesignInstance Type=local:SettingsViewModel, IsDesignTimeCreatable=True}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <infra:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <infra:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />

        <Style x:Key="HotKeyBoxStyle" TargetType="{x:Type controls:HotKeyTextBox}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:HotKeyTextBox}">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock x:Name="watermark" Text="{x:Static resx:Resources.HotkeyWatermark}" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF007ACC"/>
                                <Setter Property="Background" Value="#F0F8FF" />
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" TargetName="watermark" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="{x:Static resx:Resources.DuplicateHotkeyTooltip}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Content" Value="&#x2716;"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="BorderBrush" Value="Red"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type local:UIOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.UISettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.Theme}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                      ItemsSource="{Binding AvailableThemes}" 
                      DisplayMemberPath="Key"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Theme}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.Language}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                      ItemsSource="{Binding AvailableLanguages}" 
                      DisplayMemberPath="Key"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Language}"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static resx:Resources.RestartRequiredHint}"
                       Foreground="DarkOrange" FontStyle="Italic" Margin="0,10,0,0"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CompareOptionsViewModel}">
            <StackPanel Margin="20" Background="#FFF" >
                <TextBlock Text="{x:Static resx:Resources.CompareSettings}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <GroupBox Header="{x:Static resx:Resources.ScanOptions}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <!-- Scan method picker removed: FileSystemTreeBuilderFactory never returns an MFT builder, so "MFT" silently did nothing. -->
                        <CheckBox IsChecked="{Binding Parallel}" Content="{x:Static resx:Resources.EnableParallelScanning}" Margin="0,10,0,0"/>
                        <TextBlock Text="{x:Static resx:Resources.EnableParallelScanningHint}"
                           FontStyle="Italic" Foreground="Gray" Margin="20,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{x:Static resx:Resources.ComparisonAlgorithms}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static resx:Resources.Enable}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Static resx:Resources.Default}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Static resx:Resources.Algorithm}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="{x:Static resx:Resources.Percent}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>
                        <Separator/>

                        <ItemsControl ItemsSource="{Binding AlgorithmItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <RadioButton Grid.Column="1" IsChecked="{Binding IsDefault}" IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Width="60" 
                                         IsEnabled="{Binding IsPercentageSettingEnabled}"
                                         Text="{Binding ComparisonPercentage, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                         HorizontalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{x:Static resx:Resources.UserInteraction}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Static resx:Resources.DoubleClickAction}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableDoubleClickActions}"
                          SelectedItem="{Binding DoubleClickAction}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ListEditButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <DataTemplate DataType="{x:Type local:ConfirmationOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.ConfirmationSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <GroupBox Header="{x:Static resx:Resources.GeneralConfirmations}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding CloseApplication}" Content="{x:Static resx:Resources.ConfirmCloseApplication}" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding CloseTab}" Content="{x:Static resx:Resources.ConfirmCloseTabAction}" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding Copy}" Content="{x:Static resx:Resources.ConfirmCopy}" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding Move}" Content="{x:Static resx:Resources.ConfirmMove}" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="{x:Static resx:Resources.DangerousActions}">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding CopyOverwrite}" Content="{x:Static resx:Resources.ConfirmCopyOverwrite}" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding MoveOverwrite}" Content="{x:Static resx:Resources.ConfirmMoveOverwrite}" Margin="0,5"/>
                        <CheckBox IsChecked="{Binding DeleteFile}" Content="{x:Static resx:Resources.ConfirmDeleteFile}" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SessionOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.SessionSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static resx:Resources.DefaultSessionFile}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBox Text="{Binding DefaultSessionFile, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,5"/>
                    <Button Grid.Column="1" Content="{x:Static resx:Resources.Browse}" VerticalAlignment="Center" Padding="10,2" Margin="5,0" Command="{Binding BrowseSessionFileCommand}"/>
                </Grid>
                <CheckBox IsChecked="{Binding AutoLoadDefaultSession}" Content="{x:Static resx:Resources.AutoLoadDefaultSession}" Margin="0,10"/>
                <CheckBox IsChecked="{Binding AutoCompareAfterSessionLoad}" 
                          IsEnabled="{Binding AutoLoadDefaultSession}" 
                          Content="{x:Static resx:Resources.AutoCompareAfterSessionLoad}" Margin="0,5"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HotKeysOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.HotkeySettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>

                <TextBlock Text="{x:Static resx:Resources.HotkeySettingsHint}"
                           Foreground="SlateGray" 
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding HotKeyItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" 
                                  ToolTip="{x:Static resx:Resources.HotkeyTooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>

                                <controls:HotKeyTextBox Grid.Column="1" 
                                                      Text="{Binding Combination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource HotKeyBoxStyle}"/>

                                <Button Grid.Column="2" 
                                        Style="{StaticResource ClearButtonStyle}"
                                        Command="{Binding ClearCommand}"
                                        Margin="5,0,0,0"
                                        Visibility="{Binding Combination, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:LogOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.LogSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                <CheckBox IsChecked="{Binding IsEnabled}" Content="{x:Static resx:Resources.EnableLogging}" Margin="0,10"/>
                <Grid IsEnabled="{Binding IsEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.LogLevel}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding AvailableLogLevels}" 
                              SelectedItem="{Binding Level}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.RetentionDays}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                             Text="{Binding RetentionDays}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ImageViewerOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.ImageViewerSettingsTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{x:Static resx:Resources.ImageViewerSettingsDescription}" Foreground="SlateGray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <GroupBox Header="{x:Static resx:Resources.CompareSettings}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox IsChecked="{Binding ShowDiffByDefault}" Content="{x:Static resx:Resources.ShowDiffByDefault}" Margin="0,5"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.DefaultBlockSize}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DefaultBlockSize}" Width="60" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.DefaultThreshold}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultThreshold}" Width="60" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{x:Static resx:Resources.EXIFSettings}" Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <TextBlock Text="{x:Static resx:Resources.EXIFSettingsDescription}" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding ShowExifCamera}" Content="{x:Static resx:Resources.CameraModel}" Margin="0,2"/>
                        <CheckBox IsChecked="{Binding ShowExifLens}" Content="{x:Static resx:Resources.LensModel}" Margin="0,2"/>
                        <CheckBox IsChecked="{Binding ShowExifAperture}" Content="{x:Static resx:Resources.EXIFAperture}" Margin="0,2"/>
                        <CheckBox IsChecked="{Binding ShowExifShutterSpeed}" Content="{x:Static resx:Resources.EXIFShutterSpeed}" Margin="0,2"/>
                        <CheckBox IsChecked="{Binding ShowExifIso}" Content="{x:Static resx:Resources.EXIFISO}" Margin="0,2"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TextViewerOptionsViewModel}">
            <StackPanel Margin="20">
                <TextBlock Text="{x:Static resx:Resources.TextViewerSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="These settings apply only to the built-in text viewer." Foreground="SlateGray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <CheckBox IsChecked="{Binding ReadOnly}" Content="{x:Static resx:Resources.DefaultToReadOnly}" Margin="0,5"/>
                <CheckBox IsChecked="{Binding LineNumber}" Content="{x:Static resx:Resources.ShowLineNumbers}" Margin="0,5"/>
                <CheckBox IsChecked="{Binding SyntaxHighlight}" Content="{x:Static resx:Resources.EnableSyntaxHighlighting}" Margin="0,5"/>
                <CheckBox IsChecked="{Binding WordWrap}" Content="{x:Static resx:Resources.EnableWordWrap}" Margin="0,5"/>
                <CheckBox IsChecked="{Binding ShowStatusBar}" Content="{x:Static resx:Resources.ShowStatusBar}" Margin="0,5"/>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static resx:Resources.Font}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding FontDisplay}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="{x:Static resx:Resources.SelectFont}" Command="{Binding SelectFontCommand}" Margin="5,0"/>
                </Grid>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.HorizontalScrollBar}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding ScrollBarVisibilities}"
                              SelectedItem="{Binding HorizontalScrollBarVisibility}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.VerticalScrollBar}" VerticalAlignment="Center" Margin="0,5,10,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                              ItemsSource="{Binding ScrollBarVisibilities}"
                              SelectedItem="{Binding VerticalScrollBarVisibility}"/>
                </Grid>

                <Button Content="{x:Static resx:Resources.ResetToDefault}" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ToolsOptionsViewModel}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Margin="5">
                    <TextBlock Text="{x:Static resx:Resources.ToolsSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                    <Button Content="{x:Static resx:Resources.Add}" Command="{Binding AddToolCommand}" Width="80" Margin="5"/>
                    <Button Content="{x:Static resx:Resources.Remove}" Command="{Binding RemoveToolCommand}" Width="80" Margin="5"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid DataContext="{Binding SelectedTool}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.Name}" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5">
                        <TextBox.Text>
                            <Binding Path="Name" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.Type}" Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resx:Resources.Handler}" Margin="5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Handler, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static resx:Resources.Path}" Margin="5"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsEnabled="{Binding IsExternal}" Margin="5,5,0,5">
                            <TextBox.Text>
                                <Binding Path="Path" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <DataErrorValidationRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <Button Grid.Column="1" Content="{x:Static resx:Resources.Browse}" Command="{Binding BrowseCommand}" IsEnabled="{Binding IsExternal}" Margin="10,5,5,5" Padding="5,1"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static resx:Resources.DiffArguments}" Margin="5"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DiffArguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExternal}" Margin="5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static resx:Resources.ViewArguments}" Margin="5"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ViewArguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsExternal}" Margin="5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static resx:Resources.SupportedOperations}" Margin="5"/>
                    <ListBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding AvailableOperations}" SelectionMode="Multiple" Margin="5"
                             helper:ListBoxHelper.SelectedItems="{Binding SupportedOperations, Mode=TwoWay, ValidatesOnDataErrors=True}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{x:Static resx:Resources.SupportedExtensions}" Margin="5"/>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="5">
                        <TextBox.Text>
                            <Binding Path="SupportedExtensions" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <DataErrorValidationRule/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{x:Static resx:Resources.Features}" Margin="5"/>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Features, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Enabled}" Content="{x:Static resx:Resources.Enabled}" Margin="5"/>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FileTypeMappingOptionsViewModel}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Margin="5">
                    <TextBlock Text="{x:Static resx:Resources.FileTypeMappingSettings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                    <Button Content="{x:Static resx:Resources.Add}" Command="{Binding AddMappingCommand}" Width="80" Margin="5"/>
                    <Button Content="{x:Static resx:Resources.Remove}" Command="{Binding RemoveMappingCommand}" Width="80" Margin="5"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid DataContext="{Binding SelectedMapping}" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resx:Resources.Extensions}" Margin="5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resx:Resources.DefaultDiffTool}" Margin="5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedItem="{Binding DefaultDiffTool}" Margin="5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resx:Resources.DefaultViewTool}" Margin="5"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectedItem="{Binding DefaultViewTool}" Margin="5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static resx:Resources.PreferredDiffTools}" Margin="5"/>
                    <ListBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectionMode="Multiple" Margin="5"
                             helper:ListBoxHelper.SelectedItems="{Binding PreferredDiffTools, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static resx:Resources.PreferredViewTools}" Margin="5"/>
                    <ListBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableTools}" SelectionMode="Multiple" Margin="5"
                             helper:ListBoxHelper.SelectedItems="{Binding PreferredViewTools, Mode=TwoWay}"/>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="5">
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="5" Name="FilterTextBox"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{x:Static resx:Resources.FilterSettings}" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                <TreeView ItemsSource="{Binding MenuItems}" x:Name="SettingsTree">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:SettingsMenuItem}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="#FDFDFD">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" 
                  Margin="5">
                <ContentControl Content="{Binding SelectedViewModel}"
                        d:Content="{d:DesignInstance local:UIOptionsViewModel}"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,1,0,0" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="{x:Static resx:Resources.Save}" Width="80" Margin="5" Command="{Binding SaveConfigurationCommand}" IsEnabled="{Binding IsValid}"/>
                <Button Content="{x:Static resx:Resources.Cancel}" Width="80" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>