<UserControl x:Class="dCompare.Options.GeneralConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ControlBackground}">
    <Border Padding="15" CornerRadius="5" Background="{DynamicResource ControlBackground}">
        <StackPanel>
            <!-- Session Settings -->
            <GroupBox Header="Session Settings" Margin="0,0,0,10" Foreground="{DynamicResource TextColor}">
                <StackPanel Margin="10">
                    <Label Content="Default Session File" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    <DockPanel Margin="0,5,0,10">
                        <TextBox Text="{Binding DefaultSessionFile}" Width="400" Margin="0,0,2,0" 
                                             Foreground="{DynamicResource TextColor}" VerticalContentAlignment="Center"/>
                        <Button Width="24" Height="30" Click="Browse_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                                  Fill="#666666" Stretch="Uniform" Width="16" Height="16" Margin="0,0,0,0"/>
                                <TextBlock VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <CheckBox x:Name="LoadDefaultSessionCheckBox"
                              Content="Load Default Session on Startup" 
                              IsChecked="{Binding AutoLoadDefaultSession}" 
                              Margin="0,5,0,5" 
                              Foreground="{DynamicResource TextColor}"/>
                    <CheckBox x:Name="ExecuteComparisonCheckBox"
                              Content="Execute Comparison After Loading Session" 
                              IsChecked="{Binding AutoCompareAfterSessionLoad}" 
                              IsEnabled="{Binding IsChecked, ElementName=LoadDefaultSessionCheckBox}"
                              Margin="0,5,0,5" 
                              Foreground="{DynamicResource TextColor}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Border>
</UserControl>