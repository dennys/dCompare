<UserControl x:Class="dCompare.FileOperation.FileOperationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:dCompare"
             xmlns:local1="clr-namespace:dCompare.FileOperation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             MinHeight="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="StartButton" Content="Start" Command="{Binding StartCommand}" Margin="5"/>
            <Button x:Name="PauseButton" Content="Pause" Command="{Binding PauseCommand}" Margin="5"/>
            <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
            <TextBox x:Name="FilterTextBox" Width="200" Margin="5" local1:TextBoxBehaviors.TextChangedCommand="{Binding FilterTextChangedCommand}" ToolTip="Filter by source or target path"/>
        </StackPanel>

        <!-- TabControl with ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TabControl MaxHeight="200">
                <TabItem Header="Queued">
                    <DataGrid x:Name="QueuedGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              ItemsSource="{Binding QueuedTransfers}"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="160" 
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat={}{0:N0} bytes}" Width="100"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding Progress, StringFormat={}{0:P0}}" Width="80"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding TransferSpeed, StringFormat={}{0:N2} KB/s}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cancel" Command="{Binding CancelTransferCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Successful">
                    <DataGrid x:Name="SuccessfulGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              ItemsSource="{Binding SuccessfulTransfers}"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="160"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat={}{0:N0} bytes}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Failed">
                    <DataGrid x:Name="FailedGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              ItemsSource="{Binding FailedTransfers}"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="160"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding FileSize, StringFormat={}{0:N0} bytes}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Retry" Command="{Binding RetryTransferCommand}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </ScrollViewer>
    </Grid>
</UserControl>