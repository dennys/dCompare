<UserControl x:Class="dCompare.Viewer.ImageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:dCompare.Viewer"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0">
            <Button Content="📂 Open" Command="{Binding OpenImageCommand}" Margin="2"/>
            <Button Content="💾 Save" Command="{Binding SaveImageCommand}" Margin="2"/>
            <Button Content="🔎 Zoom In" Command="{Binding ZoomInCommand}" Margin="2"/>
            <Button Content="🔍 Zoom Out" Command="{Binding ZoomOutCommand}" Margin="2"/>
            <Button Content="📏 Fit to Window" Click="FitToWindow_Click" Margin="2"/>
        </ToolBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="ImageViewerImage" Source="{Binding ImageSource}" Stretch="{Binding ImageStretch}" RenderTransform="{Binding ImageScaleTransform}" />
        </ScrollViewer>
    </Grid>
</UserControl>
