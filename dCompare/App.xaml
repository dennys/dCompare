<Application x:Class="dCompare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:dCompare">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
		<Image x:Key="AddTabIcon" 			Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/add_tab.ico"/>
		<Image x:Key="CloseTabIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/close_tab.ico"/>
		<Image x:Key="CollapseAllIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/collapse_all.ico"/>
		<Image x:Key="CompareIcon" 			Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/compare.ico"/>
		<Image x:Key="CompareContentIcon" 	Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/compare_content.ico"/>
		<Image x:Key="CopyToLeftIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/copy_to_left.ico"/>
		<Image x:Key="CopyToRightIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/copy_to_right.ico"/>
		<Image x:Key="DeleteIcon" 			Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/delete.ico"/>
		<Image x:Key="ExpandAllIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/expand_all.ico"/>
		<Image x:Key="LoadSessionIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/load_session.ico"/>
		<Image x:Key="RemoveTabIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/remove_tab.ico"/>
		<Image x:Key="SaveSessionIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/save_session.ico"/>
		<Image x:Key="ShowAllIcon" 			Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/show_all.ico"/>
		<Image x:Key="ShowDifferentIcon"	Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/show_different.ico"/>
		<Image x:Key="ShowIdenticalIcon" 	Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/show_identical.ico"/>
		<Image x:Key="ShowLeftIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/show_left.ico"/>
		<Image x:Key="ShowRightIcon" 		Width="16" Height="16" Source="pack://application:,,,/Resources/Icons/show_right.ico"/>

    </Application.Resources>
</Application>
