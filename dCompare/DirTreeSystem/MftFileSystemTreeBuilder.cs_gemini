using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using System.Threading;
using Microsoft.Win32.SafeHandles;

namespace dCompare.DirTreeSystem
{
    /// <summary>
    /// Builds a file system tree by reading the NTFS Master File Table (MFT) directly.
    /// This method is very fast but requires administrative privileges.
    /// </summary>
    public class MftFileSystemTreeBuilder : IFileSystemTreeBuilder
    {
        public FileSystemNode BuildTreeRecursive(string path, int depth, CancellationToken cancellationToken, Action? onDirectoryProcessed)
        {
            if (string.IsNullOrEmpty(path) || !Directory.Exists(path))
            {
                throw new DirectoryNotFoundException($"The specified path does not exist: {path}");
            }

            var rootPath = Path.GetPathRoot(path);
            if (string.IsNullOrEmpty(rootPath))
            {
                throw new ArgumentException("Could not determine the volume for the given path.", nameof(path));
            }

            var driveLetter = rootPath.Substring(0, 1);

            // Read all entries from the MFT for the entire volume.
            var allNodes = ReadMft(driveLetter, cancellationToken);

            // Reconstruct the tree structure from the flat list of nodes.
            var rootNode = BuildTreeFromFlatList(allNodes, path, onDirectoryProcessed);

            // The initial depth passed is for the root of the requested path. 
            // We need to adjust the depth of all children relative to it.
            AdjustDepth(rootNode, depth);

            return rootNode;
        }

        private void AdjustDepth(FileSystemNode node, int depth)
        {
            node.Depth = depth;
            foreach (var child in node.Children)
            {
                AdjustDepth(child, depth + 1);
            }
        }

        /// <summary>
        /// Reads all file records from the MFT of a specified volume.
        /// </summary>
        private Dictionary<long, FileSystemNode> ReadMft(string driveLetter, CancellationToken cancellationToken)
        {
            var nodes = new Dictionary<long, FileSystemNode>();
            SafeFileHandle volumeHandle = GetVolumeHandle(driveLetter);

            using (volumeHandle)
            {
                if (volumeHandle.IsInvalid)
                {
                    throw new Win32Exception(Marshal.GetLastWin32Error(), $"Could not open handle to volume '{driveLetter}:'. Make sure you are running as an administrator.");
                }

                var mftEnumData = new MftApi.MFT_ENUM_DATA_V0
                {
                    StartFileReferenceNumber = 0,
                    LowUsn = 0,
                    HighUsn = long.MaxValue
                };

                IntPtr mftEnumDataPtr = Marshal.AllocHGlobal(Marshal.SizeOf(mftEnumData));
                Marshal.StructureToPtr(mftEnumData, mftEnumDataPtr, false);

                // Buffer to receive the USN records.
                int bufferSize = 64 * 1024; // 64KB buffer
                IntPtr buffer = Marshal.AllocHGlobal(bufferSize);

                try
                {
                    while (true)
                    {
                        cancellationToken.ThrowIfCancellationRequested();

                        if (!MftApi.DeviceIoControl(
                                volumeHandle,
                                MftApi.FSCTL_ENUM_USN_DATA,
                                mftEnumDataPtr,
                                (uint)Marshal.SizeOf(mftEnumData),
                                buffer,
                                (uint)bufferSize,
                                out uint bytesReturned,
                                IntPtr.Zero)
                           )
                        {
                            int error = Marshal.GetLastWin32Error();
                            // ERROR_NO_MORE_FILES is expected when enumeration is complete.
                            if (error == MftApi.ERROR_NO_MORE_FILES || error == MftApi.ERROR_HANDLE_EOF)
                            {
                                break;
                            }
                            throw new Win32Exception(error, "Failed to enumerate USN data from MFT.");
                        }

                        if (bytesReturned <= MftApi.USN_RECORD_COMMON_HEADER_SIZE)
                        {
                            break;
                        }

                        IntPtr currentUsnRecordPtr = IntPtr.Add(buffer, (int)MftApi.USN_RECORD_COMMON_HEADER_SIZE);
                        long recordsToProcess = (bytesReturned - MftApi.USN_RECORD_COMMON_HEADER_SIZE);

                        while (recordsToProcess > 0)
                        {
                            var usnRecord = (MftApi.USN_RECORD_V2)Marshal.PtrToStructure(currentUsnRecordPtr, typeof(MftApi.USN_RECORD_V2));

                            var node = new FileSystemNode
                            {
                                Name = usnRecord.FileName,
                                FullPath = string.Empty, // Will be constructed later
                                IsDirectory = (usnRecord.FileAttributes & (uint)FileAttributes.Directory) != 0,
                                ModifiedTime = DateTime.FromFileTime(usnRecord.TimeStamp),
                                Size = usnRecord.ActualFileSize
                            };

                            // We use a dictionary with the File Reference Number as the key
                            // to handle potential duplicates and for easy lookup later.
                            nodes[usnRecord.FileReferenceNumber] = node;

                            // Store the parent reference to build the tree later
                            node.Children.Add(new FileSystemNode { Name = usnRecord.ParentFileReferenceNumber.ToString() }); // A bit of a hack to store parent ref

                            long recordLength = usnRecord.RecordLength;
                            recordsToProcess -= recordLength;
                            currentUsnRecordPtr = IntPtr.Add(currentUsnRecordPtr, (int)recordLength);
                        }

                        // Update the starting point for the next call
                        long nextStartFrn = Marshal.ReadInt64(buffer, 0);
                        mftEnumData.StartFileReferenceNumber = nextStartFrn;
                        Marshal.StructureToPtr(mftEnumData, mftEnumDataPtr, false);
                    }
                }
                finally
                {
                    Marshal.FreeHGlobal(buffer);
                    Marshal.FreeHGlobal(mftEnumDataPtr);
                }
            }

            return nodes;
        }

        /// <summary>
        /// Constructs the hierarchical tree from the flat list of nodes read from the MFT.
        /// </summary>
        private FileSystemNode BuildTreeFromFlatList(Dictionary<long, FileSystemNode> allNodes, string targetPath, Action? onDirectoryProcessed)
        {
            var tree = new Dictionary<long, FileSystemNode>();

            // First pass: clone nodes and prepare for parenting
            foreach (var kvp in allNodes)
            {
                var originalNode = kvp.Value;
                var newNode = new FileSystemNode
                {
                    Name = originalNode.Name,
                    IsDirectory = originalNode.IsDirectory,
                    ModifiedTime = originalNode.ModifiedTime,
                    Size = originalNode.Size,
                    FullPath = string.Empty // Will be set during tree walk
                };
                tree[kvp.Key] = newNode;
            }

            // Second pass: link children to parents
            foreach (var kvp in allNodes)
            {
                long fileRef = kvp.Key;
                var originalNode = kvp.Value;

                // Retrieve parent reference number stored in the hacky way
                if (originalNode.Children.Count > 0 && long.TryParse(originalNode.Children[0].Name, out long parentFileRef))
                {
                    if (tree.TryGetValue(parentFileRef, out FileSystemNode parentNode) && fileRef != parentFileRef)
                    {
                        parentNode.Children.Add(tree[fileRef]);
                        onDirectoryProcessed?.Invoke();
                    }
                }
            }

            // Find the root of the volume (usually FRN 5 for C:\) and build full paths
            FileSystemNode? volumeRoot = null;
            if (tree.TryGetValue(5, out var rootCand)) // FRN 5 is typically the root directory
            {
                volumeRoot = rootCand;
                string rootDrive = Path.GetPathRoot(targetPath);
                BuildFullPaths(volumeRoot, rootDrive.TrimEnd('\\'));
            }
            else
            {
                throw new InvalidOperationException("Could not find the root of the volume in the MFT data.");
            }

            // Finally, find and return the node corresponding to the target path.
            return FindNodeByPath(volumeRoot, targetPath) ?? throw new DirectoryNotFoundException($"Could not locate path '{targetPath}' in the constructed MFT tree.");
        }

        private void BuildFullPaths(FileSystemNode node, string parentPath)
        {
            node.FullPath = Path.Combine(parentPath, node.Name);
            if (node.IsDirectory)
            {
                long totalSize = 0;
                foreach (var child in node.Children)
                {
                    BuildFullPaths(child, node.FullPath);
                    totalSize += child.Size;
                }
                node.Size = totalSize;
            }
        }

        private FileSystemNode? FindNodeByPath(FileSystemNode startNode, string path)
        {
            if (startNode.FullPath.Equals(path, StringComparison.OrdinalIgnoreCase))
            {
                return startNode;
            }

            foreach (var child in startNode.Children)
            {
                if (path.StartsWith(child.FullPath, StringComparison.OrdinalIgnoreCase))
                {
                    var found = FindNodeByPath(child, path);
                    if (found != null)
                    {
                        return found;
                    }
                }
            }

            return null;
        }


        private SafeFileHandle GetVolumeHandle(string driveLetter)
        {
            var path = $@"\\.\{driveLetter}:";
            return MftApi.CreateFile(
                path,
                FileAccess.Read,
                FileShare.ReadWrite,
                IntPtr.Zero,
                FileMode.Open,
                MftApi.FILE_FLAG_BACKUP_SEMANTICS,
                IntPtr.Zero
            );
        }

        /// <summary>
        /// Contains P/Invoke signatures and native structures for MFT enumeration.
        /// </summary>
        private static class MftApi
        {
            public const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
            public const int ERROR_NO_MORE_FILES = 18;
            public const int ERROR_HANDLE_EOF = 38;
            public const uint FSCTL_ENUM_USN_DATA = 0x000900b3;
            public const int USN_RECORD_COMMON_HEADER_SIZE = 8;


            [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
            public static extern SafeFileHandle CreateFile(
                string lpFileName,
                [MarshalAs(UnmanagedType.U4)] FileAccess dwDesiredAccess,
                [MarshalAs(UnmanagedType.U4)] FileShare dwShareMode,
                IntPtr lpSecurityAttributes,
                [MarshalAs(UnmanagedType.U4)] FileMode dwCreationDisposition,
                uint dwFlagsAndAttributes,
                IntPtr hTemplateFile);

            [DllImport("kernel32.dll", SetLastError = true)]
            [return: MarshalAs(UnmanagedType.Bool)]
            public static extern bool DeviceIoControl(
                SafeFileHandle hDevice,
                uint dwIoControlCode,
                IntPtr lpInBuffer,
                uint nInBufferSize,
                IntPtr lpOutBuffer,
                uint nOutBufferSize,
                out uint lpBytesReturned,
                IntPtr lpOverlapped);

            [StructLayout(LayoutKind.Sequential)]
            public struct MFT_ENUM_DATA_V0
            {
                public long StartFileReferenceNumber;
                public long LowUsn;
                public long HighUsn;
            }

            [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
            public struct USN_RECORD_V2
            {
                public uint RecordLength;
                public ushort MajorVersion;
                public ushort MinorVersion;
                public long FileReferenceNumber;
                public long ParentFileReferenceNumber;
                public long Usn;
                public long TimeStamp;
                public uint Reason;
                public uint SourceInfo;
                public uint SecurityId;
                public uint FileAttributes;
                public ushort FileNameLength;
                public ushort FileNameOffset;
                [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 1)]
                public string FileName;
                public long ActualFileSize; // Not part of the official struct, but we can get it
            }
        }
    }
}
