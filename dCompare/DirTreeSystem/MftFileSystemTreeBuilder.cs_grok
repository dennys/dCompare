using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using System.Threading;
using dCompare.DirTreeSystem;
using Serilog;

namespace dCompare.DirTreeSystem
{
    public class MftFileSystemTreeBuilder : IFileSystemTreeBuilder
    {
        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct FILE_RECORD_SEGMENT_HEADER
        {
            public uint Magic; // "FILE"
            public ushort UpdateSequenceOffset;
            public ushort UpdateSequenceSize;
            public ulong LogFileSequenceNumber;
            public ushort SequenceNumber;
            public ushort HardLinkCount;
            public ushort AttributeOffset;
            public ushort Flags;
            public uint UsedSize;
            public uint AllocatedSize;
            public ulong FileReferenceNumber;
            public ushort NextAttributeId;
            // Additional fields omitted for simplicity
        }

        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct ATTRIBUTE_RECORD_HEADER
        {
            public uint TypeId;
            public uint RecordLength;
            public byte NonResident;
            public byte NameLength;
            public ushort NameOffset;
            public ushort Flags;
            public ushort Instance;
            // Additional fields for resident/non-resident attributes
        }

        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct STANDARD_INFORMATION
        {
            public long CreationTime;
            public long LastModificationTime;
            public long LastChangeTime;
            public long LastAccessTime;
            public uint FileAttributes;
            // Additional fields omitted
        }

        [StructLayout(LayoutKind.Sequential, Pack = 1)]
        private struct FILE_NAME
        {
            public ulong ParentDirectory;
            public byte NameLength;
            public byte Flags;
            [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 255)]
            public string Name;
        }

        [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Auto)]
        private static extern IntPtr CreateFile(
            string lpFileName,
            uint dwDesiredAccess,
            uint dwShareMode,
            IntPtr lpSecurityAttributes,
            uint dwCreationDisposition,
            uint dwFlagsAndAttributes,
            IntPtr hTemplateFile);

        [DllImport("kernel32.dll", SetLastError = true)]
        private static extern bool CloseHandle(IntPtr hObject);

        [DllImport("kernel32.dll", SetLastError = true)]
        private static extern bool DeviceIoControl(
            IntPtr hDevice,
            uint dwIoControlCode,
            IntPtr lpInBuffer,
            uint nInBufferSize,
            IntPtr lpOutBuffer,
            uint nOutBufferSize,
            out uint lpBytesReturned,
            IntPtr lpOverlapped);

        private const uint GENERIC_READ = 0x80000000;
        private const uint FILE_SHARE_READ = 0x00000001;
        private const uint FILE_SHARE_WRITE = 0x00000002;
        private const uint OPEN_EXISTING = 3;
        private const uint FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
        private const uint FSCTL_GET_NTFS_FILE_RECORD = 0x90068;
        private const uint FILE_ATTRIBUTE_DIRECTORY = 0x00000010;
        private const uint ATTR_TYPE_STANDARD_INFORMATION = 0x10;
        private const uint ATTR_TYPE_FILE_NAME = 0x30;
        private const uint ATTR_TYPE_DATA = 0x80;

        public FileSystemNode BuildTreeRecursive(string path, int depth, CancellationToken cancellationToken, Action? onDirectoryProcessed)
        {
            Log.Information("Building tree for path: {Path}, depth: {Depth}", path, depth);
            cancellationToken.ThrowIfCancellationRequested();

            string volumePath = GetVolumePath(path);
            Log.Information("Volume path: {VolumePath}", volumePath);

            FileSystemNode root = new()
            {
                Name = Path.GetFileName(path) ?? Path.GetPathRoot(path) ?? "Root",
                FullPath = path,
                IsDirectory = true,
                Depth = depth
            };

            IntPtr hVolume = IntPtr.Zero;
            try
            {
                Log.Information("Opening volume handle for: {VolumePath}", volumePath);
                hVolume = CreateFile(
                    volumePath,
                    GENERIC_READ,
                    FILE_SHARE_READ | FILE_SHARE_WRITE,
                    IntPtr.Zero,
                    OPEN_EXISTING,
                    FILE_FLAG_BACKUP_SEMANTICS,
                    IntPtr.Zero);

                if (hVolume == IntPtr.Zero || hVolume == new IntPtr(-1))
                {
                    int errorCode = Marshal.GetLastWin32Error();
                    Log.Error("Failed to open volume {VolumePath}. Error code: {ErrorCode}", volumePath, errorCode);
                    throw new Win32Exception(errorCode, "Failed to open volume");
                }
                Log.Information("Volume handle opened successfully: {Handle}", hVolume);

                // Process MFT records
                long totalSize = 0;
                List<FileSystemNode> children = new List<FileSystemNode>();
                uint recordIndex = 0;
                const int bufferSize = 65536; // 64KB
                byte[] buffer = new byte[bufferSize];
                IntPtr bufferPtr = Marshal.AllocHGlobal(bufferSize);

                try
                {
                    while (true)
                    {
                        cancellationToken.ThrowIfCancellationRequested();
                        Log.Information("Reading MFT record index: {RecordIndex} for path: {Path}", recordIndex, path);

                        uint bytesReturned;
                        bool success = DeviceIoControl(
                            hVolume,
                            FSCTL_GET_NTFS_FILE_RECORD,
                            ref recordIndex,
                            sizeof(uint),
                            bufferPtr,
                            (uint)buffer.Length,
                            out bytesReturned,
                            IntPtr.Zero);

                        if (!success)
                        {
                            int errorCode = Marshal.GetLastWin32Error();
                            if (errorCode == 234) // ERROR_NO_MORE_ITEMS
                            {
                                Log.Information("Reached end of MFT records for {Path}", path);
                                break;
                            }
                            Log.Error("Failed to read MFT record {RecordIndex} for {Path}. Error code: {ErrorCode}", recordIndex, path, errorCode);
                            throw new Win32Exception(errorCode, $"Failed to read MFT record {recordIndex}");
                        }

                        if (bytesReturned == 0)
                        {
                            Log.Warning("No data returned for MFT record {RecordIndex} in {Path}", recordIndex, path);
                            recordIndex++;
                            continue;
                        }

                        Log.Information("MFT record {RecordIndex} read, bytes returned: {BytesReturned}", recordIndex, bytesReturned);

                        // Parse MFT rekord
                        FILE_RECORD_SEGMENT_HEADER record = Marshal.PtrToStructure<FILE_RECORD_SEGMENT_HEADER>(bufferPtr);
                        if (record.Magic != 0x454C4946) // "FILE"
                        {
                            Log.Warning("Invalid MFT record magic at index {RecordIndex}", recordIndex);
                            recordIndex++;
                            continue;
                        }

                        // Parse attributes
                        int offset = record.AttributeOffset;
                        string name = null;
                        bool isDirectory = false;
                        long size = 0;
                        DateTime modifiedTime = DateTime.MinValue;
                        ulong parentFrn = 0;

                        while (offset < bytesReturned)
                        {
                            ATTRIBUTE_RECORD_HEADER attr = Marshal.PtrToStructure<ATTRIBUTE_RECORD_HEADER>(IntPtr.Add(bufferPtr, offset));
                            if (attr.TypeId == 0xFFFFFFFF) // End of attributes
                                break;

                            if (attr.TypeId == ATTR_TYPE_STANDARD_INFORMATION)
                            {
                                STANDARD_INFORMATION stdInfo = Marshal.PtrToStructure<STANDARD_INFORMATION>(IntPtr.Add(bufferPtr, offset + 24));
                                modifiedTime = DateTime.FromFileTime(stdInfo.LastModificationTime);
                                isDirectory = (stdInfo.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
                            }
                            else if (attr.TypeId == ATTR_TYPE_FILE_NAME)
                            {
                                FILE_NAME fileName = Marshal.PtrToStructure<FILE_NAME>(IntPtr.Add(bufferPtr, offset + 24));
                                name = fileName.Name.Substring(0, fileName.NameLength / 2); // Unicode chars
                                parentFrn = fileName.ParentDirectory;
                            }
                            else if (attr.TypeId == ATTR_TYPE_DATA && !isDirectory)
                            {
                                // Simplified: assume resident data for files
                                size = Marshal.ReadInt64(IntPtr.Add(bufferPtr, offset + 24));
                            }

                            offset += (int)attr.RecordLength;
                        }

                        if (name == null || !path.EndsWith(name, StringComparison.OrdinalIgnoreCase))
                        {
                            recordIndex++;
                            continue;
                        }

                        string fullPath = Path.Combine(path, name);
                        FileSystemNode node = new()
                        {
                            Name = name,
                            FullPath = fullPath,
                            IsDirectory = isDirectory,
                            Size = size,
                            ModifiedTime = modifiedTime,
                            Depth = depth + 1
                        };

                        if (isDirectory)
                        {
                            Log.Information("Processing directory from MFT: {FullPath}", fullPath);
                            FileSystemNode childDir = BuildTreeRecursive(fullPath, depth + 1, cancellationToken, onDirectoryProcessed);
                            children.Add(childDir);
                            totalSize += childDir.Size;
                            onDirectoryProcessed?.Invoke();
                        }
                        else
                        {
                            Log.Information("Added file from MFT: {Name}, Size: {Size}", name, size);
                            children.Add(node);
                            totalSize += size;
                        }

                        recordIndex++;
                    }

                    root.Children = children;
                    root.Size = totalSize;
                    root.ModifiedTime = modifiedTime != DateTime.MinValue ? modifiedTime : DateTime.Now;
                    Log.Information("Completed processing {Path}. Total size: {TotalSize}, Children count: {ChildrenCount}", path, totalSize, children.Count);
                }
                finally
                {
                    Marshal.FreeHGlobal(bufferPtr);
                    Log.Information("Freed MFT buffer for {Path}", path);
                }
            }
            catch (Win32Exception ex)
            {
                Log.Error(ex, "Win32 error during MFT access for {Path}", path);
                throw;
            }
            catch (Exception ex)
            {
                Log.Error(ex, "Unexpected error while processing {Path}", path);
                throw;
            }
            finally
            {
                if (hVolume != IntPtr.Zero && hVolume != new IntPtr(-1))
                {
                    CloseHandle(hVolume);
                    Log.Information("Closed volume handle for {VolumePath}", volumePath);
                }
            }

            Log.Information("Returning root node for {Path}: {RootName}, Size: {RootSize}, Children: {ChildrenCount}", path, root.Name, root.Size, root.Children.Count);
            return root;
        }

        private string GetVolumePath(string path)
        {
            string root = Path.GetPathRoot(path) ?? "C:\\";
            string volumePath = $@"\\.\{root.TrimEnd('\\')}";
            Log.Information("Converted path {Path} to volume path: {VolumePath}", path, volumePath);
            return volumePath;
        }
    }
}