<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Resources\Strings.resx" />
    <EmbeddedResource Remove="Resources\Strings.zh-TW.resx" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Themes\DarkTheme.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Strings.resx" />
    <Resource Include="Resources\Strings.zh-TW.resx" />
    <Resource Include="Themes\DarkTheme.xaml" />
  </ItemGroup>

</Project>
