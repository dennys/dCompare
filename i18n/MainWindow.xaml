<Window x:Class="i18n.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:i18n"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="15">
        <StackPanel>
            <Label Content="{DynamicResource ThemeLabel}" />
            <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>

            <Label Content="{DynamicResource LanguageLabel}" Margin="0,10,0,0" />
            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Content="English" Tag="en-US" />
                <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
            </ComboBox>

            <TextBlock Text="{DynamicResource GreetingText}" FontSize="20" Margin="0,20,0,0" HorizontalAlignment="Center" />

        </StackPanel>
    </Grid>
</Window>
