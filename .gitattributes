###############################################################################
# Line endings are pinned HERE, not by each developer's core.autocrlf setting.
# (core.autocrlf is per-machine and therefore not reproducible.)
#
#   repo stores LF  ->  checkout converts per the eol= rule below.
#
# This project is Windows-only WPF built in Visual Studio, so source files are
# checked out with CRLF (what VS and the existing history already use). JSON and
# Markdown stay LF so editors/CLI tools that write LF stop flapping.
###############################################################################

* text=auto eol=lf

# --- Source / project files: CRLF on disk (Visual Studio) ---
*.cs          text eol=crlf
*.csproj      text eol=crlf
*.xaml        text eol=crlf
*.resx        text eol=crlf
*.sln         text eol=crlf
*.props       text eol=crlf
*.targets     text eol=crlf
*.config      text eol=crlf
*.manifest    text eol=crlf
*.settings    text eol=crlf
*.user        text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# --- Plain text that is edited/produced by cross-platform tooling: LF ---
*.json        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.txt         text eol=lf

# --- Explicitly binary: never touch bytes (text=auto heuristics are not reliable) ---
*.dll         binary
*.exe         binary
*.pdb         binary
*.ico         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.zip         binary
*.lic         binary
*.db          binary
*.db-shm      binary
*.db-wal      binary
*.vsidx       binary
*.suo         binary
*.wsuo        binary
*.sqlite      binary
*.v2          binary
*.v16         binary
*.testlog     binary
*.pdf         binary

# --- Generated output: never let git try to diff/merge these ---
*.resources   binary
*.g.resources binary
