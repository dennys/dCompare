<Window x:Class="dCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dCompare"
        Title="MainWindow" Height="450" Width="800">

	<Window.InputBindings>
		<KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddTabCommand}"/>
		<KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
	</Window.InputBindings>

	<Window.Resources>
		<!-- TabItem Header Template with "-" Button -->
		<Style TargetType="TabItem">
			<Setter Property="HeaderTemplate">
				<Setter.Value>
					<DataTemplate>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Header}" VerticalAlignment="Center" Margin="5,0"/>
							<Button Content="-" Width="20" Height="20" Margin="5,0" FontSize="12"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseTabCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}"/>
						</StackPanel>
					</DataTemplate>
				</Setter.Value>
			</Setter>

			<!-- Enable drag-and-drop -->
			<Setter Property="AllowDrop" Value="True"/>
			<EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown"/>
			<EventSetter Event="Drop" Handler="TabItem_Drop"/>
		</Style>
		<!-- TabControl Template with "+" Button -->
		<Style TargetType="TabControl">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabControl">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<StackPanel Orientation="Horizontal" Grid.Row="0">
								<TabPanel x:Name="HeaderPanel" IsItemsHost="True"/>
								<Button Content="+" Width="20" Height="20" Margin="0,0,0,0" FontSize="16"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AddTabCommand}"/>
							</StackPanel>
							<ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<DockPanel>
		<!-- Menu Bar -->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New" Click="Test_Click"/>
				<MenuItem Header="_Exit" Click="Test_Click"/>
			</MenuItem>
			<MenuItem Header="_Edit">
				<MenuItem Header="_Change Tab Header" Click="Test_Click"/>
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_About" Click="Test_Click"/>
			</MenuItem>
		</Menu>

		<!-- ToolBar -->
		<ToolBar DockPanel.Dock="Top">
			<Button Content="New Tab" Click="Test_Click"/>
			<Button Content="Change Header" Click="Test_Click"/>
			<Separator/>
			<Button Content="About" Click="Test_Click"/>
		</ToolBar>

		<!-- Status Bar -->
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock x:Name="StatusText" Text="Ready"/>
			</StatusBarItem>
		</StatusBar>

		<!-- TabControl -->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<TabControl x:Name="tabControl" Grid.Row="0" PreviewMouseMove="TabControl_PreviewMouseMove">
				<TabItem Header="Tab 1">
					<local:UcCompare/>
				</TabItem>
			</TabControl>
		</Grid>
	</DockPanel>
</Window>
