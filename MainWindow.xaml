<Window x:Class="dCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dCompare"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>

        <!-- 選擇資料夾路徑 -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5">
            <TextBox x:Name="LeftPathBox" Width="400" Margin="5,0" />
            <Button Content="Browse Left" Click="BrowseLeft_Click" Margin="2"/>
            <TextBox x:Name="RightPathBox" Width="400" Margin="10,0,0,0"/>
            <Button Content="Browse Right" Click="BrowseRight_Click" Margin="2"/>
            <Button Content="Compare" Click="Compare_Click" Margin="10,0"/>
        </StackPanel>

        <!-- 同步按鈕 -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5">
            <Button Content="Copy to Left" Click="CopyToLeft_Click" Margin="5"/>
            <Button Content="Copy to Right" Click="CopyToRight_Click" Margin="5"/>
        </StackPanel>

        <!-- 清單檢視 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListView x:Name="ResultListView"
                      Margin="5"
                      SelectionMode="Extended"
                      ContextMenuOpening="ResultListView_ContextMenuOpening">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy to Left" Click="CopyToLeft_Click"/>
                        <MenuItem Header="Copy to Right" Click="CopyToRight_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Status" Width="60"
                                        DisplayMemberBinding="{Binding StatusSymbol}" />
                        <GridViewColumn Header="Name" Width="300"
                                        DisplayMemberBinding="{Binding TreeIndent}" />
                        <GridViewColumn Header="Size (L)" Width="80"
                                        DisplayMemberBinding="{Binding LeftSize}" />
                        <GridViewColumn Header="Date (L)" Width="140"
                                        DisplayMemberBinding="{Binding LeftDate}" />
                        <GridViewColumn Header="Size (R)" Width="80"
                                        DisplayMemberBinding="{Binding RightSize}" />
                        <GridViewColumn Header="Date (R)" Width="140"
                                        DisplayMemberBinding="{Binding RightDate}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
    </DockPanel>
</Window>
