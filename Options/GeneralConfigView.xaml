<UserControl x:Class="dCompare.GeneralConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ControlBackground}">
    <StackPanel Margin="10">
        <Label Content="Default Session File" Foreground="{DynamicResource TextColor}"/>
        <DockPanel Margin="5">
            <TextBox Text="{Binding DefaultSessionFile}" Width="200" Foreground="{DynamicResource TextColor}"/>
            <Button Width="80" Click="Browse_Click" Margin="0,0,5,0">
                <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
            </Button>
        </DockPanel>
        <CheckBox Content="Load Default Session on Startup" IsChecked="{Binding LoadDefaultSessionOnStartup}" Margin="5"
                  Foreground="{DynamicResource TextColor}"/>
    </StackPanel>
</UserControl>