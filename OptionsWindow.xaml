<Window x:Class="dCompare.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="450" Width="800"
        Background="#F0F0F0" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10">
            <Label Content="Theme" />
            <ComboBox SelectedItem="{Binding Theme}" Margin="5">
                <ComboBoxItem Content="light"/>
                <ComboBoxItem Content="dark"/>
            </ComboBox>

            <Label Content="Language" Margin="0,10,0,0"/>
            <ComboBox SelectedItem="{Binding Language}" Margin="5">
                <ComboBoxItem Content="en-US"/>
                <ComboBoxItem Content="zh-TW"/>
                <ComboBoxItem Content="zh-CN"/>
            </ComboBox>

            <Label Content="Log Settings" Margin="0,10,0,0"/>
            <CheckBox Content="Enable Logging" IsChecked="{Binding Log.Enabled}" Margin="5"/>
            <Label Content="Log Level" Margin="0,5,0,0"/>
            <ComboBox SelectedItem="{Binding Log.Level}" Margin="5">
                <ComboBoxItem Content="Verbose"/>
                <ComboBoxItem Content="Debug"/>
                <ComboBoxItem Content="Information"/>
                <ComboBoxItem Content="Warning"/>
                <ComboBoxItem Content="Error"/>
                <ComboBoxItem Content="Fatal"/>
            </ComboBox>
            <Label Content="Log Retention Days" Margin="0,5,0,0"/>
            <TextBox Text="{Binding Log.RetentionDays}" Margin="5" Width="100"/>

            <!-- Hotkey configuration can be added similarly with textboxes or a custom editor -->
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="5" Click="OK_Click"/>
            <Button Content="Cancel" Width="80" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>